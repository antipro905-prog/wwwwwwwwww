	.. "Prediction helps against running targets: try 50–100 ms in games with slow bullets, keep 0 for instant guns. "
	.. "If bullets always fly a bit to the side, turn on Show Shot Point: if the red dot is on the enemy but bullets miss, "
	.. "your game shoots at the screen center — turn off Aim at Cursor. On phones turn off Hold Right Mouse.")
paragraph(aimbotPage, "Cursor mode and shooting", "Without Shift Lock your cursor jumps to the target and the screen stays still. "
	.. "Guns shoot where the real mouse points, and Roblox doesn't let scripts move it, "
	.. "so when you shoot the screen turns at once and the bullets hit (Aim Camera When Shooting). "
	.. "In Shift Lock or first person the camera always aims. In your own gun script you can also use:\n"
	.. "local aim = _G.W1MIW_AimPosition or mouse.Hit.Position")

-- Teleport
do -- Teleport page (kept local to save variables)
	local teleportPage = createTab("Teleport", "◈", "Jump to any player")

	state.tpOffset = CONFIG.TeleportOffset
	state.clickTp = CONFIG.ClickTeleport
	state.tpButtons = CONFIG.TPButtons

	-- TP buttons above heads are BillboardGuis in PlayerGui (only there they can be
	-- clicked). Remove the ones a previous run of the script left behind
	for _, old in ipairs(playerGui:GetChildren()) do
		if string.sub(old.Name, 1, 9) == "W1MIW_TP_" then
			old:Destroy()
		end
	end

	-- moves your character to cf; returns true when it worked
	local function teleportTo(cf)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = humanoid and humanoid.RootPart
		if not root or humanoid.Health <= 0 then
			notify("Can't teleport", "Your character isn't loaded yet", 3)
			return false
		end
		if humanoid.SeatPart then
			humanoid.Sit = false -- get out of seats and cars first
		end
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		character:PivotTo(cf)
		if flight then
			flight.Velocity = Vector3.zero -- keep flying calmly from the new spot
		end
		return true
	end

	-- appear behind the player, looking the same way they look
	local function teleportToPlayer(other)
		local character = other.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then
			notify("Can't teleport", other.DisplayName .. " has no character right now", 3)
			return
		end
		if teleportTo(root.CFrame * CFrame.new(0, 0, state.tpOffset)) then
			notify("Teleported", "To " .. other.DisplayName, 2)
		end
	end

	section(teleportPage, "Settings")
	slider(teleportPage, "Distance Behind Player", 0, 20, state.tpOffset, " studs", function(value)
		state.tpOffset = value
	end)
	toggle(teleportPage, nil, "TP Buttons Above All Players", "Or press + next to one player for just that one", state.tpButtons, function(enabled)
		state.tpButtons = enabled -- the buttons update within half a second
	end)
	toggle(teleportPage, nil, "Click Teleport", "Hold Ctrl and click to teleport there", state.clickTp, function(enabled)
		state.clickTp = enabled
		if enabled then
			notify("Click Teleport enabled", "Hold Ctrl and click anywhere", 3)
		else
			notify("Click Teleport disabled", "Ctrl + click does nothing now", 3)
		end
	end)

	-- Ctrl + click: teleport to the point under the mouse
	local tpMouse = player:GetMouse()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not state.clickTp or input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		if not (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		local hit = tpMouse.Hit.Position
		-- 3 studs up so you stand on the spot instead of inside it; keep facing the same way
		teleportTo(CFrame.new(hit + Vector3.new(0, 3, 0)) * root.CFrame.Rotation)
	end)

	section(teleportPage, "Players")

	-- search by name
	local filterFrame = create("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = THEME.Field,
		BackgroundTransparency = 0.25,
		LayoutOrder = nextOrder(),
		Parent = teleportPage,
	})
	paint(filterFrame, "BackgroundColor3", "Field")
	corner(filterFrame, 12)
	local filterStroke = stroke(filterFrame, 0.85, 1)
	local filterBox = create("TextBox", {
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -28, 1, 0),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		Text = "",
		PlaceholderText = "Find a player...",
		PlaceholderColor3 = THEME.IconTint,
		TextColor3 = COMMON.Text,
		Font = FONT_MEDIUM,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = filterFrame,
	})
	paint(filterBox, "PlaceholderColor3", "IconTint")
	filterBox.Focused:Connect(function()
		tween(filterStroke, 0.25, { Color = THEME.Accent, Transparency = 0.2 })
	end)
	filterBox.FocusLost:Connect(function()
		tween(filterStroke, 0.25, { Color = COMMON.White, Transparency = 0.85 })
	end)

	local list = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(),
		Parent = teleportPage,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.Name, -- alphabetical by display name
		Parent = list,
	})
	local emptyLabel = label({
		Name = "", -- sorts first
		Size = UDim2.new(1, 0, 0, 44),
		Text = "",
		Font = FONT_REGULAR,
		TextSize = 14,
		TextColor3 = COMMON.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = list,
	})

	local rows = {} -- [player] = { Frame, Info, Avatar, Button, Stroke }

	local function refreshList()
		local query = lowerText(filterBox.Text)
		local shown, total = 0, 0
		for other, row in pairs(rows) do
			total = total + 1
			local match = query == ""
				or string.find(lowerText(other.DisplayName), query, 1, true) ~= nil
				or string.find(lowerText(other.Name), query, 1, true) ~= nil
			row.Frame.Visible = match
			if match then
				shown = shown + 1
			end
		end
		emptyLabel.Visible = shown == 0
		emptyLabel.Text = total == 0 and "No other players on the server yet" or "Nobody matches the search"
	end
	filterBox:GetPropertyChangedSignal("Text"):Connect(refreshList)

	local function addRow(other)
		if other == player or rows[other] then
			return
		end
		local userId = tonumber(other.UserId) or 0
		local row = create("Frame", {
			Name = string.lower(other.DisplayName) .. "_" .. tostring(userId),
			Size = UDim2.new(1, 0, 0, 48),
			BackgroundColor3 = THEME.Card,
			BackgroundTransparency = 0.3,
			Parent = list,
		})
		corner(row, 12)
		local rowStroke = stroke(row, 0.93, 1)
		local avatar = create("ImageLabel", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 10, 0.5, 0),
			Size = UDim2.fromOffset(32, 32),
			BackgroundColor3 = THEME.Field,
			Image = ("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150"):format(userId),
			Parent = row,
		})
		round(avatar)
		label({
			Position = UDim2.fromOffset(52, 7),
			Size = UDim2.new(1, -140, 0, 18),
			Text = other.DisplayName,
			Font = FONT_BOLD,
			TextSize = 14,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = row,
		})
		local info = label({
			Position = UDim2.fromOffset(52, 25),
			Size = UDim2.new(1, -140, 0, 15),
			Text = "@" .. other.Name,
			Font = FONT_REGULAR,
			TextSize = 12,
			TextColor3 = COMMON.SubText,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = row,
		})
		local button = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(44, 28),
			BackgroundColor3 = THEME.Accent,
			AutoButtonColor = false,
			Text = "TP",
			Font = FONT_BOLD,
			TextSize = 13,
			TextColor3 = Color3.fromRGB(24, 16, 10),
			Parent = row,
		})
		corner(button, 10)
		local buttonScale = create("UIScale", { Parent = button })
		button.MouseEnter:Connect(function()
			tween(buttonScale, 0.2, { Scale = 1.08 })
			tween(rowStroke, 0.2, { Transparency = 0.75 })
		end)
		button.MouseLeave:Connect(function()
			tween(buttonScale, 0.2, { Scale = 1 })
			tween(rowStroke, 0.2, { Transparency = 0.93 })
		end)
		button.MouseButton1Click:Connect(function()
			buttonScale.Scale = 0.92
			tween(buttonScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			teleportToPlayer(other)
		end)

		-- "+": puts one TP button above this player's head ("-" removes it)
		local pinButton = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -60, 0.5, 0),
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = THEME.Field,
			AutoButtonColor = false,
			Text = "+",
			Font = FONT_BOLD,
			TextSize = 18,
			TextColor3 = COMMON.Text,
			Parent = row,
		})
		corner(pinButton, 8)

		-- the TP button above this player's head. It is made only while it is needed
		-- (TP Buttons on, or this player pinned with +): nothing of the menu sits in
		-- PlayerGui when you don't use it, because MM2 starts its own scripts there
		-- again every time you respawn
		local entry = { Frame = row, Info = info, Avatar = avatar, Button = button, HeadTag = nil, HeadButton = nil, Pin = pinButton, Pinned = false }
		function entry.Need(wanted)
			if wanted and not entry.HeadTag then
				local headTag = create("BillboardGui", {
					Name = "W1MIW_TP_" .. other.Name,
					Size = UDim2.fromOffset(34, 16),
					StudsOffset = Vector3.new(0, 4.3, 0), -- above the ESP name tag
					AlwaysOnTop = true,
					Active = true, -- lets the button be clicked
					LightInfluence = 0,
					MaxDistance = 1000,
					ResetOnSpawn = false,
					Enabled = false,
					Parent = playerGui,
				})
				local headButton = create("TextButton", {
					Size = UDim2.fromScale(1, 1),
					BackgroundColor3 = THEME.Accent,
					AutoButtonColor = false,
					Text = "TP",
					Font = FONT_BOLD,
					TextSize = 10,
					TextColor3 = Color3.fromRGB(24, 16, 10),
					Parent = headTag,
				})
				corner(headButton, 6)
				stroke(headButton, 0.35, 1, COMMON.White)
				headButton.MouseEnter:Connect(function()
					tween(headButton, 0.15, { BackgroundColor3 = THEME.Accent2 })
				end)
				headButton.MouseLeave:Connect(function()
					tween(headButton, 0.15, { BackgroundColor3 = THEME.Accent })
				end)
				headButton.MouseButton1Click:Connect(function()
					teleportToPlayer(other)
				end)
				entry.HeadTag, entry.HeadButton = headTag, headButton
			elseif not wanted and entry.HeadTag then
				entry.HeadTag:Destroy()
				entry.HeadTag, entry.HeadButton = nil, nil
			end
			return entry.HeadTag
		end
		pinButton.MouseButton1Click:Connect(function()
			entry.Pinned = not entry.Pinned
			pinButton.Text = entry.Pinned and "−" or "+"
			pinButton.BackgroundColor3 = entry.Pinned and COMMON.Green or THEME.Field
			pinButton.TextColor3 = entry.Pinned and Color3.fromRGB(14, 30, 18) or COMMON.Text
			local character = other.Character
			local head = character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local headTag = entry.Need(state.tpButtons or entry.Pinned)
			if headTag then
				headTag.Adornee = head
				headTag.Enabled = head ~= nil and humanoid ~= nil and humanoid.Health > 0
			end
			if entry.Pinned then
				notify("TP button added", "Click TP above " .. other.DisplayName .. "'s head", 2)
			end
		end)
		rows[other] = entry
		refreshList()
	end

	local function removeRow(other)
		local row = rows[other]
		if row then
			rows[other] = nil
			row.Frame:Destroy()
			row.Need(false)
			refreshList()
		end
	end

	-- one theme hook for all rows (rows come and go with players)
	onTheme(function()
		for _, row in pairs(rows) do
			row.Frame.BackgroundColor3 = THEME.Card
			row.Avatar.BackgroundColor3 = THEME.Field
			row.Button.BackgroundColor3 = THEME.Accent
			if row.HeadButton then
				row.HeadButton.BackgroundColor3 = THEME.Accent
			end
			if not row.Pinned then
				row.Pin.BackgroundColor3 = THEME.Field
			end
		end
	end)

	for _, other in ipairs(Players:GetPlayers()) do
		addRow(other)
	end
	refreshList()
	Players.PlayerAdded:Connect(addRow)
	Players.PlayerRemoving:Connect(removeRow)

	-- the menu was closed for good (script restarted): remove the head buttons too
	gui.Destroying:Connect(function()
		for _, row in pairs(rows) do
			row.Need(false)
		end
	end)

	-- twice a second: head buttons follow the characters (respawns),
	-- distances are updated while the Teleport page is open
	task.spawn(function()
		while gui.Parent do
			for other, row in pairs(rows) do
				local character = other.Character
				local head = character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local headTag = row.Need(state.tpButtons or row.Pinned)
				if headTag then
					headTag.Adornee = head
					headTag.Enabled = head ~= nil and humanoid ~= nil and humanoid.Health > 0
				end
			end
			if menuVisible and teleportPage.Visible then
				local myCharacter = player.Character
				local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
				for other, row in pairs(rows) do
					local character = other.Character
					local root = character and character:FindFirstChild("HumanoidRootPart")
					local text = "@" .. other.Name
					if not root then
						text = text .. "  •  no character"
					elseif myRoot then
						text = text .. "  •  " .. math.floor((root.Position - myRoot.Position).Magnitude) .. " studs"
					end
					row.Info.Text = text
				end
			end
			task.wait(0.5)
		end
	end)

	-- Places: saved spots you can teleport to (Prison Life spots from your
	-- SimpleTP script + your own). Built in its own function to keep variables apart
	local function buildPlaces()
		-- teleport in steps, like in your SimpleTP script
		local function stepTeleport(target)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if not root then
				notify("Can't teleport", "Your character isn't loaded yet", 3)
				return
			end
			local start = root.Position
			local distance = (target - start).Magnitude
			if distance < 15 then
				root.CFrame = CFrame.new(target)
				return
			end
			local steps = math.clamp(math.floor(distance / 25), 4, 12)
			for i = 1, steps do
				if not root.Parent then
					break
				end
				root.AssemblyLinearVelocity = Vector3.new(0, 0.1, 0)
				root.AssemblyAngularVelocity = Vector3.zero
				root.CFrame = CFrame.new(start:Lerp(target, i / steps))
				task.wait(0.003)
			end
			root.CFrame = CFrame.new(target)
		end

		-- where you stood before the last place-teleport (for the Back button)
		local lastSpot

		local function goTo(name, target)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				lastSpot = root.Position
			end
			task.spawn(stepTeleport, target)
			notify("Teleported", name, 2)
		end

		section(teleportPage, "Places")
		-- small tiles, two in a row: click a tile to teleport
		local placeList = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = nextOrder(),
			Parent = teleportPage,
		})
		create("UIGridLayout", {
			CellSize = UDim2.new(0.5, -3, 0, 30),
			CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = placeList,
		})
		local placeTiles = {} -- for recoloring with the theme
		local placeOrder = 0

		local function addPlace(name, position, custom)
			placeOrder = placeOrder + 1
			local short = string.gsub(name, "^TP ", "")
			local tile = create("TextButton", {
				BackgroundColor3 = custom and COMMON.Green or THEME.Card,
				BackgroundTransparency = custom and 0.55 or 0.3,
				AutoButtonColor = false,
				Text = "",
				LayoutOrder = placeOrder,
				Parent = placeList,
			})
			corner(tile, 9)
			stroke(tile, 0.9, 1)
			label({
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.new(1, custom and -34 or -14, 1, 0),
				Text = "➜ " .. short,
				Font = FONT_BOLD,
				TextSize = 12,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = tile,
			})
			tile.MouseEnter:Connect(function()
				tween(tile, 0.15, { BackgroundTransparency = 0.05 })
			end)
			tile.MouseLeave:Connect(function()
				tween(tile, 0.15, { BackgroundTransparency = custom and 0.55 or 0.3 })
			end)
			tile.MouseButton1Click:Connect(function()
				goTo(short, position)
			end)
			if custom then
				local delete = create("TextButton", {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -4, 0.5, 0),
					Size = UDim2.fromOffset(22, 22),
					BackgroundColor3 = COMMON.Close,
					BackgroundTransparency = 0.2,
					AutoButtonColor = false,
					Text = "×",
					Font = FONT_BOLD,
					TextSize = 14,
					TextColor3 = COMMON.White,
					Parent = tile,
				})
				corner(delete, 7)
				delete.MouseButton1Click:Connect(function()
					tile:Destroy()
					placeTiles[tile] = nil
				end)
			else
				placeTiles[tile] = true
			end
		end

		onTheme(function()
			for tile in pairs(placeTiles) do
				tile.BackgroundColor3 = THEME.Card
			end
		end)

		for _, place in ipairs(CONFIG.Places) do
			addPlace(place[1], Vector3.new(place[2], place[3], place[4]), false)
		end

		-- one small row: [name] [+] [Back]. "+" adds a tile for the spot you stand on
		local saveCard = card(teleportPage, 44)
		local nameBox = create("TextBox", {
			Position = UDim2.fromOffset(8, 7),
			Size = UDim2.new(1, -112, 0, 30),
			BackgroundColor3 = THEME.Field,
			ClearTextOnFocus = false,
			Text = "",
			PlaceholderText = "Name (optional)",
			PlaceholderColor3 = THEME.IconTint,
			TextColor3 = COMMON.Text,
			Font = FONT_MEDIUM,
			TextSize = 13,
			Parent = saveCard,
		})
		corner(nameBox, 8)
		paint(nameBox, "BackgroundColor3", "Field")
		local plusButton = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -66, 0, 7),
			Size = UDim2.fromOffset(32, 30),
			BackgroundColor3 = COMMON.Green,
			AutoButtonColor = false,
			Text = "+",
			Font = FONT_BOLD,
			TextSize = 20,
			TextColor3 = Color3.fromRGB(14, 30, 18),
			Parent = saveCard,
		})
		corner(plusButton, 8)
		local backButton = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -8, 0, 7),
			Size = UDim2.fromOffset(54, 30),
			BackgroundColor3 = THEME.Accent,
			AutoButtonColor = false,
			Text = "↩ Back",
			Font = FONT_BOLD,
			TextSize = 12,
			TextColor3 = Color3.fromRGB(24, 16, 10),
			Parent = saveCard,
		})
		corner(backButton, 8)
		paint(backButton, "BackgroundColor3", "Accent")
		backButton.MouseButton1Click:Connect(function()
			if not lastSpot then
				notify("Back", "Teleport to a place first", 2)
				return
			end
			goTo("back", lastSpot)
		end)

		-- the line to paste into CONFIG.Places so the place stays forever
		-- (shows up only after you press +; select it and Ctrl+C)
		local codeBox = create("TextBox", {
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundColor3 = COMMON.Black,
			BackgroundTransparency = 0.5,
			ClearTextOnFocus = false,
			TextEditable = false,
			Text = "",
			TextColor3 = COMMON.Green,
			Font = Enum.Font.Code,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = nextOrder(),
			Visible = false,
			Parent = teleportPage,
		})
		corner(codeBox, 8)
		padding(codeBox, 0, 8, 0, 8)

		local saved = 0
		plusButton.MouseButton1Click:Connect(function()
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if not root then
				notify("Can't save", "Your character isn't loaded yet", 3)
				return
			end
			saved = saved + 1
			local name = nameBox.Text ~= "" and nameBox.Text or ("My Spot " .. saved)
			name = string.gsub(name, '"', "'")
			local p = root.Position
			local x, y, z = math.floor(p.X + 0.5), math.floor(p.Y + 0.5), math.floor(p.Z + 0.5)
			addPlace(name, Vector3.new(x, y, z), true)
			codeBox.Text = string.format('{ "%s", %d, %d, %d },', name, x, y, z)
			codeBox.Visible = true
			nameBox.Text = ""
			notify("Place added", name, 2)
		end)
	end
	buildPlaces()

	paragraph(teleportPage, "Tips", "TP puts you behind the player, looking the same way. "
		.. "TP buttons above heads: click one to jump to that player (in Shift Lock put the crosshair on it). "
		.. "Click Teleport: hold Ctrl and left-click any spot. Turn on Noclip if you land inside a wall.")
end

-- Mimic: your character repeats every move of another player
do -- Mimic (kept local to save variables)
	local mimicPage = createTab("Mimic", "◐", "Repeat every move of a player")

	state.mimicOn = false
	local mimic = {
		Side = CONFIG.MimicSide,
		FromSpot = false, -- repeat the moves from where you stand (not beside them)
		Mirror = false, -- left and right swapped, like a mirror
		Anims = CONFIG.MimicAnimations,
		Played = {}, -- [animation id] = your copy of their animation track
	}

	local function rootOf(who)
		local character = who and who.Character
		return character and character:FindFirstChild("HumanoidRootPart")
	end

	-- the same move, but with left and right swapped
	local function mirrored(cf)
		local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
		return CFrame.new(-x, y, z, r00, -r01, -r02, -r10, r11, r12, -r20, r21, r22)
	end

	-- give your own animations back (the Animate script plays walk / jump again)
	local function stopCopiedAnims()
		for _, track in pairs(mimic.Played) do
			pcall(function()
				track:Stop(0.2)
			end)
		end
		table.clear(mimic.Played)
		if mimic.Animate and mimic.Animate.Parent then
			mimic.Animate.Disabled = false
		end
		mimic.Animate = nil
	end
	table.insert(state.onClose, stopCopiedAnims) -- your walk animation always comes back

	-- remember where you both stand: every move is counted from here
	local function resetAnchors()
		local theirRoot, myRoot = rootOf(mimic.Target), rootOf(player)
		mimic.TheirChar = mimic.Target and mimic.Target.Character
		if player.Character ~= mimic.MyChar then
			table.clear(mimic.Played) -- the old tracks belonged to your old character
			mimic.Animate = nil
		end
		mimic.MyChar = player.Character
		mimic.LastGoal = nil
		if not theirRoot or not myRoot then
			mimic.TheirStart = nil
			return
		end
		mimic.TheirStart = theirRoot.CFrame
		if mimic.FromSpot then
			mimic.MyStart = myRoot.CFrame
		else
			mimic.MyStart = theirRoot.CFrame * CFrame.new(mimic.Side, 0, 0)
		end
	end

	local refreshRows -- defined below
	local statusText

	local function modeText()
		local where = mimic.FromSpot and "from your spot" or (mimic.Side .. " studs beside them")
		return where .. (mimic.Mirror and ", mirrored" or "") .. (mimic.Anims and ", with animations" or "")
	end

	local stopMimic
	function stopMimic(reason)
		if not state.mimicOn then
			return
		end
		state.mimicOn = false
		stopCopiedAnims()
		local myRoot = rootOf(player)
		if myRoot then
			myRoot.AssemblyLinearVelocity = Vector3.zero
		end
		local name = mimic.Target and mimic.Target.DisplayName or "player"
		mimic.Target = nil
		if refreshRows then
			refreshRows()
		end
		notify("Mimic stopped", reason or ("You stopped copying " .. name), 3)
	end
	state.stopMimic = stopMimic -- the "Fix My Character" button uses it

	local function startMimic(other)
		if state.farmOn and state.farmToggle then
			state.farmToggle.Set(false) -- the farm would move you somewhere else
		end
		if state.flyEnabled then
			flyToggle.Set(false)
		end
		stopCopiedAnims()
		mimic.Target = other
		mimic.MyChar = nil
		state.mimicOn = true
		resetAnchors()
		refreshRows()
		notify("Copying " .. other.DisplayName, modeText() .. ". " .. CONFIG.MimicStopKey.Name .. " — stop", 3)
	end

	-- play the same animations they play (walk, jump, emotes, dances)
	local function syncAnims()
		local myCharacter = player.Character
		local myHumanoid = myCharacter and myCharacter:FindFirstChildOfClass("Humanoid")
		local myAnimator = myHumanoid and myHumanoid:FindFirstChildOfClass("Animator")
		local theirCharacter = mimic.Target and mimic.Target.Character
		local theirHumanoid = theirCharacter and theirCharacter:FindFirstChildOfClass("Humanoid")
		local theirAnimator = theirHumanoid and theirHumanoid:FindFirstChildOfClass("Animator")
		if not myAnimator or not theirAnimator then
			return
		end
		-- your Animate script would play its own walk on top: pause it while copying
		local animate = myCharacter:FindFirstChild("Animate")
		if animate and mimic.Animate ~= animate then
			mimic.Animate = animate
			animate.Disabled = true
			for _, track in ipairs(myAnimator:GetPlayingAnimationTracks()) do
				track:Stop(0.1)
			end
			table.clear(mimic.Played)
		end
		local seen = {}
		for _, track in ipairs(theirAnimator:GetPlayingAnimationTracks()) do
			local animation = track.Animation
			local id = animation and animation.AnimationId
			if id and id ~= "" then
				seen[id] = true
				local mine = mimic.Played[id]
				if not mine then
					local ok, loaded = pcall(myAnimator.LoadAnimation, myAnimator, animation)
					if ok and loaded then
						mine = loaded
						mimic.Played[id] = mine
						pcall(function()
							mine.Priority = track.Priority
							mine.Looped = track.Looped
						end)
						mine:Play(0.15, track.WeightTarget, track.Speed)
						pcall(function()
							mine.TimePosition = track.TimePosition
						end)
					end
				end
				if mine then
					if not mine.IsPlaying then
						mine:Play(0.15, track.WeightTarget, track.Speed)
					end
					if math.abs(mine.Speed - track.Speed) > 0.01 then
						mine:AdjustSpeed(track.Speed)
					end
				end
			end
		end
		for id, mine in pairs(mimic.Played) do
			if not seen[id] then
				mine:Stop(0.15)
				mimic.Played[id] = nil
			end
		end
	end

	-- every frame: put your character where their move takes it
	RunService.Heartbeat:Connect(function(dt)
		if not state.mimicOn then
			return
		end
		local other = mimic.Target
		if not other or other.Parent ~= Players then
			stopMimic("The player left the game")
			return
		end
		if state.farmOn then
			stopMimic("Auto Farm took over")
			return
		end
		local myCharacter = player.Character
		local myHumanoid = myCharacter and myCharacter:FindFirstChildOfClass("Humanoid")
		if myHumanoid and myHumanoid.Health <= 0 then
			stopMimic("You died")
			return
		end
		if other.Character ~= mimic.TheirChar or myCharacter ~= mimic.MyChar or not mimic.TheirStart then
			resetAnchors() -- someone respawned: start counting again
		end
		local theirRoot, myRoot = rootOf(other), rootOf(player)
		if not theirRoot or not myRoot or not mimic.TheirStart then
			return
		end
		local goal
		if mimic.Mirror or mimic.FromSpot then
			local move = mimic.TheirStart:Inverse() * theirRoot.CFrame
			if mimic.Mirror then
				move = mirrored(move)
			end
			goal = mimic.MyStart * move
		else
			goal = theirRoot.CFrame * CFrame.new(mimic.Side, 0, 0)
		end
		-- your speed = how fast the goal moves (so the game sees you walking)
		local velocity = Vector3.zero
		if mimic.LastGoal and dt > 0 then
			velocity = (goal.Position - mimic.LastGoal) / dt
			if velocity.Magnitude > 200 then
				velocity = Vector3.zero -- a teleport, not a step
			end
		end
		mimic.LastGoal = goal.Position
		myRoot.AssemblyLinearVelocity = velocity
		myRoot.AssemblyAngularVelocity = Vector3.zero
		myRoot.CFrame = goal
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not gameProcessed and state.mimicOn and input.KeyCode == CONFIG.MimicStopKey then
			stopMimic()
		end
	end)

	section(mimicPage, "Status")
	local _, statusLabel = paragraph(mimicPage, "Mimic", "Not copying anyone")
	statusText = statusLabel
	local stopButton = card(mimicPage, 40, "TextButton")
	label({
		Size = UDim2.fromScale(1, 1),
		Text = "■  Stop copying  (" .. CONFIG.MimicStopKey.Name .. ")",
		Font = FONT_BOLD,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = stopButton,
	})
	stopButton.MouseButton1Click:Connect(function()
		if state.mimicOn then
			stopMimic()
		else
			notify("Mimic", "You're not copying anyone", 2)
		end
	end)

	section(mimicPage, "Settings")
	toggle(mimicPage, nil, "From My Spot", "Repeat their moves where you stand, not beside them", mimic.FromSpot, function(enabled)
		mimic.FromSpot = enabled
		mimic.TheirStart = nil -- start counting again from the current spots
	end)
	toggle(mimicPage, nil, "Mirror", "Left and right swapped, like a reflection", mimic.Mirror, function(enabled)
		mimic.Mirror = enabled
		mimic.TheirStart = nil
	end)
	toggle(mimicPage, nil, "Copy Animations", "Walk, jump, emotes and dances like them", mimic.Anims, function(enabled)
		mimic.Anims = enabled
		if not enabled then
			stopCopiedAnims()
		end
	end)
	slider(mimicPage, "Side Distance", 0, 15, mimic.Side, " studs", function(value)
		mimic.Side = value
		mimic.TheirStart = nil
	end)

	section(mimicPage, "Players")
	local list = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(),
		Parent = mimicPage,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.Name,
		Parent = list,
	})
	local emptyLabel = label({
		Name = "",
		Size = UDim2.new(1, 0, 0, 40),
		Text = "No other players on the server yet",
		Font = FONT_REGULAR,
		TextSize = 14,
		TextColor3 = COMMON.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = list,
	})
	local rows = {} -- [player] = { Frame, Info, Avatar, Button }

	function refreshRows()
		local count = 0
		for other, row in pairs(rows) do
			count = count + 1
			local copying = state.mimicOn and mimic.Target == other
			row.Button.Text = copying and "Stop" or "Copy"
			row.Button.BackgroundColor3 = copying and COMMON.Close or THEME.Accent
			row.Button.TextColor3 = copying and COMMON.White or Color3.fromRGB(24, 16, 10)
		end
		emptyLabel.Visible = count == 0
		if statusText then
			statusText.Text = state.mimicOn and mimic.Target
				and ("Copying " .. mimic.Target.DisplayName .. " — " .. modeText())
				or "Not copying anyone"
		end
	end

	local function addRow(other)
		if other == player or rows[other] then
			return
		end
		local userId = tonumber(other.UserId) or 0
		local row = create("Frame", {
			Name = string.lower(other.DisplayName) .. "_" .. tostring(userId),
			Size = UDim2.new(1, 0, 0, 48),
			BackgroundColor3 = THEME.Card,
			BackgroundTransparency = 0.3,
			Parent = list,
		})
		corner(row, 12)
		stroke(row, 0.93, 1)
		local avatar = create("ImageLabel", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 10, 0.5, 0),
			Size = UDim2.fromOffset(32, 32),
			BackgroundColor3 = THEME.Field,
			Image = ("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150"):format(userId),
			Parent = row,
		})
		round(avatar)
		label({
			Position = UDim2.fromOffset(52, 7),
			Size = UDim2.new(1, -130, 0, 18),
			Text = other.DisplayName,
			Font = FONT_BOLD,
			TextSize = 14,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = row,
		})
		local info = label({
			Position = UDim2.fromOffset(52, 25),
			Size = UDim2.new(1, -130, 0, 15),
			Text = "@" .. other.Name,
			Font = FONT_REGULAR,
			TextSize = 12,
			TextColor3 = COMMON.SubText,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = row,
		})
		local button = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(60, 28),
			BackgroundColor3 = THEME.Accent,
			AutoButtonColor = false,
			Text = "Copy",
			Font = FONT_BOLD,
			TextSize = 13,
			TextColor3 = Color3.fromRGB(24, 16, 10),
			Parent = row,
		})
		corner(button, 9)
		button.MouseButton1Click:Connect(function()
			if state.mimicOn and mimic.Target == other then
				stopMimic()
			else
				startMimic(other)
			end
		end)
		rows[other] = { Frame = row, Info = info, Avatar = avatar, Button = button }
		refreshRows()
	end

	local function removeRow(other)
		local row = rows[other]
		if row then
			rows[other] = nil
			row.Frame:Destroy()
			refreshRows()
		end
	end

	onTheme(function()
		for _, row in pairs(rows) do
			row.Frame.BackgroundColor3 = THEME.Card
			row.Avatar.BackgroundColor3 = THEME.Field
		end
		refreshRows()
	end)

	for _, other in ipairs(Players:GetPlayers()) do
		addRow(other)
	end
	refreshRows()
	Players.PlayerAdded:Connect(addRow)
	Players.PlayerRemoving:Connect(removeRow)

	-- animations 10 times a second, distances twice a second
	task.spawn(function()
		local tick = 0
		while gui.Parent do
			if state.mimicOn and mimic.Anims then
				pcall(syncAnims)
			end
			tick = tick + 1
			if tick % 5 == 0 then
				refreshRows()
				if menuVisible and mimicPage.Visible then
					local myRoot = rootOf(player)
					for other, row in pairs(rows) do
						local root = rootOf(other)
						local text = "@" .. other.Name
						if not root then
							text = text .. "  •  no character"
						elseif myRoot then
							text = text .. "  •  " .. math.floor((root.Position - myRoot.Position).Magnitude) .. " studs"
						end
						row.Info.Text = text
					end
				end
			end
			task.wait(0.1)
		end
		stopMimic("Menu closed")
	end)

	paragraph(mimicPage, "Tips", "Copy: your character repeats everything the player does — walking, jumping, turning. "
		.. "From My Spot: they step forward, you step forward where you are. Mirror: they go left, you go right. "
		.. "Walls don't stop you while copying. Press " .. CONFIG.MimicStopKey.Name .. " to stop.")
end

-- MM2 Trade: shows what each item in a trade is worth, can accept / decline by itself
do -- MM2 Trade (kept local to save variables)
	local tradePage = createTab("MM2 Value", "⇄", "What items are worth, is the trade a profit")
	local trade = {
		AutoAccept = CONFIG.TradeAutoAccept,
		AutoDecline = CONFIG.TradeAutoDecline,
		MinProfit = CONFIG.TradeMinProfit,
		Wait = CONFIG.TradeWait,
		Estimates = CONFIG.TradeUseEstimates,
		Overlay = true,
		New = {}, -- [simple name] = true: new items without a value yet
		Values = {}, -- [simple name] = value (weapons)
		PetValues = {}, -- [simple name] = value (pets)
		Names = {}, -- [simple name] = name to show
		Custom = {}, -- values you set in the game: [name] = value
		Remotes = {},
		Sliders = {}, -- settings the Long Farm tab saves and brings to the next server
		Stamp = 0, -- grows on every trade update: old accept / decline timers see it and stop
	}
	state.tradeSliders = trade.Sliders
	local SAVE_FILE = "W1MIW_MM2Values.txt"
	local YELLOW = Color3.fromRGB(255, 205, 80)

	-- "Traveler's Gun", "TravelersGun" and "travelers gun" are the same item
	local function simple(name)
		return (string.gsub(string.lower(tostring(name)), "[^%w]", ""))
	end

	local function setValue(name, value)
		local key = simple(name)
		if key ~= "" then
			trade.Values[key] = value
			trade.Names[key] = name
		end
	end
	for name, value in pairs(CONFIG.MM2Values) do
		setValue(name, value)
	end
	for _, name in ipairs(CONFIG.MM2NewItems) do
		trade.New[simple(name)] = name
	end
	for name, value in pairs(CONFIG.MM2PetValues) do
		local key = simple(name)
		trade.PetValues[key] = value
		trade.Names["pet:" .. key] = name .. " (pet)"
	end
	-- your own values from last time (only if the executor can read files)
	pcall(function()
		if readfile and isfile and isfile(SAVE_FILE) then
			for line in string.gmatch(readfile(SAVE_FILE), "[^\n]+") do
				local name, value = string.match(line, "^(.-)=(%-?[%d%.]+)$")
				if name and tonumber(value) then
					trade.Custom[name] = tonumber(value)
					setValue(name, tonumber(value))
				end
			end
		end
	end)
	local function saveCustom()
		return (pcall(function()
			local lines = {}
			for name, value in pairs(trade.Custom) do
				table.insert(lines, name .. "=" .. value)
			end
			writefile(SAVE_FILE, table.concat(lines, "\n"))
		end))
	end

	local function formatNumber(n)
		local text = tostring(math.floor(math.abs(n) + 0.5))
		text = string.reverse(text)
		text = string.gsub(text, "(%d%d%d)", "%1,")
		text = string.reverse(text)
		if string.sub(text, 1, 1) == "," then
			text = string.sub(text, 2)
		end
		return (n < 0 and "-" or "") .. text
	end

	-- MM2's own item list is NOT loaded any more: reading it meant running MM2's own
	-- modules (require) from the executor, and MM2 loads the same modules again every
	-- time you respawn. Values work by item name, their cheap items count as ~0

	local CHEAP = { common = true, uncommon = true, rare = true, legendary = true }
	-- name to show, value (nil = unknown) and whether the value is only a guess
	local function itemInfo(id, kind)
		kind = kind or (trade.Kinds and trade.Kinds[id])
		local entry = trade.ItemList and trade.ItemList[id]
		local shown = tostring(id)
		local rarity
		if type(entry) == "table" then
			if type(entry.ItemName) == "string" then
				shown = entry.ItemName
			elseif type(entry.Name) == "string" then
				shown = entry.Name
			end
			rarity = entry.Rarity
			-- chromas can be stored as the normal name + Chroma = true
			if entry.Chroma == true and not string.find(string.lower(shown), "chroma") then
				shown = "Chroma " .. shown
			end
		end
		local weapon = trade.Values[simple(shown)] or trade.Values[simple(id)]
		local pet = trade.PetValues[simple(shown)] or trade.PetValues[simple(id)]
		local value
		if kind == "Pets" then
			value = pet
		elseif kind == "Weapons" then
			value = weapon
		elseif weapon and pet then
			value = math.min(weapon, pet) -- don't know if it's a pet: the safer value
		else
			value = weapon or pet
		end
		-- 1-of-1 items (Gold ..., Nik's Scythe): lists give them made-up millions.
		-- They are shown as PRICELESS and never counted
		if value and value >= CONFIG.PricelessFrom then
			return shown, nil, false, false, true
		end
		if value then
			return shown, value, false
		end
		-- a brand-new item: no guess, it really has no value yet
		if trade.New[simple(shown)] or trade.New[simple(id)] then
			return shown, nil, false, true
		end
		if rarity then
			if CHEAP[simple(rarity)] then
				return shown, 0, false -- common .. legendary items are worth almost nothing
			end
			for name, guess in pairs(CONFIG.RarityValues) do
				if simple(name) == simple(rarity) then
					return shown, guess, true
				end
			end
		end
		return shown, nil, false
	end

	-- every item in an offer, whatever shape MM2 sends it in:
	-- { {id, amount}, ... }, { [id] = amount }, { Weapons = {...}, Pets = {...} } ...
	local function collect(offer, out)
		out = out or {}
		if type(offer) ~= "table" then
			return out
		end
		for key, entry in pairs(offer) do
			if type(entry) == "table" then
				local id = entry[1] or entry.ItemName or entry.ItemID or entry.Id or entry.Name or entry.Item
				if type(id) == "string" then
					table.insert(out, {
						Id = id,
						Amount = tonumber(entry[2] or entry.Amount or entry.Count) or 1,
						Type = type(entry[3]) == "string" and entry[3] or entry.Type,
					})
				else
					collect(entry, out)
				end
			elseif type(entry) == "string" then
				table.insert(out, { Id = entry, Amount = 1 })
			elseif type(entry) == "number" and type(key) == "string" then
				table.insert(out, { Id = key, Amount = entry })
			end
		end
		return out
	end

	-- adds up one side of the trade. theirSide = true: their items that are on no
	-- value list count as ~0 (every valuable item is on the list, the rest is
	-- common ... legendary). Never for your side: you must not give something away for "0"
	local function addUp(offer, theirSide)
		local result = { Lines = {}, Items = {}, Total = 0, Unknown = 0, Guessed = 0, GuessedTotal = 0 }
		for _, item in ipairs(collect(offer)) do
			table.insert(result.Items, item)
			local shown, value, guessed, new, priceless = itemInfo(item.Id, item.Type)
			if guessed and not trade.Estimates then
				value = nil
			end
			local start = "  " .. shown .. " x" .. item.Amount .. "  —  "
			if value then
				result.Total = result.Total + value * item.Amount
				if guessed then
					result.Guessed = result.Guessed + item.Amount
					result.GuessedTotal = result.GuessedTotal + value * item.Amount
					table.insert(result.Lines, start .. "≈" .. formatNumber(value * item.Amount) .. " (guess by rarity)")
				else
					table.insert(result.Lines, start .. formatNumber(value * item.Amount))
				end
			elseif theirSide and trade.Estimates and not new and not priceless then
				result.Guessed = result.Guessed + item.Amount
				table.insert(result.Lines, start .. "≈0 (not on the value list — common … legendary)")
			else
				result.Unknown = result.Unknown + item.Amount
				table.insert(result.Lines, start .. (priceless and "PRICELESS (1 of 1) — not counted"
					or new and "? NEW item — no value yet (Fix A Value)" or "? (no value — Fix A Value)"))
			end
		end
		return result
	end

	-- "profit", "loss", "unknown" or "empty"
	local function judge(give, get)
		if give.Unknown > 0 then
			return "unknown" -- you can't know what you lose
		end
		if give.Total == 0 and get.Total == 0 and get.Unknown == 0 then
			return "empty"
		end
		if get.Total > give.Total and get.Total >= give.Total * (1 + trade.MinProfit / 100) then
			return "profit" -- items without a value on their side are only a bonus
		end
		if get.Unknown > 0 then
			return "unknown"
		end
		return "loss"
	end

	-- a short text of any table (Debug: shows how MM2 sends the trade)
	local function dump(value, depth)
		depth = depth or 0
		if typeof(value) == "Instance" then
			return value.ClassName .. "(" .. value.Name .. ")"
		elseif type(value) ~= "table" then
			return type(value) == "string" and ('"' .. value .. '"') or tostring(value)
		elseif depth > 4 then
			return "{...}"
		end
		local parts = {}
		for key, entry in pairs(value) do
			table.insert(parts, tostring(key) .. "=" .. dump(entry, depth + 1))
			if #parts >= 12 then
				table.insert(parts, "...")
				break
			end
		end
		return "{" .. table.concat(parts, ", ") .. "}"
	end

	section(tradePage, "Item Values — type any item")
	local searchCard = card(tradePage, 44)
	local searchBox = create("TextBox", {
		Position = UDim2.fromOffset(8, 7),
		Size = UDim2.new(1, -16, 0, 30),
		BackgroundColor3 = THEME.Field,
		ClearTextOnFocus = false,
		Text = "",
		PlaceholderText = "Find an item... (e.g. evergun)",
		PlaceholderColor3 = THEME.IconTint,
		TextColor3 = COMMON.Text,
		Font = FONT_MEDIUM,
		TextSize = 13,
		Parent = searchCard,
	})
	corner(searchBox, 8)
	paint(searchBox, "BackgroundColor3", "Field")
	local _, resultText = paragraph(tradePage, "Values", "")

	local function showSearch()
		local query = simple(searchBox.Text)
		local found = {}
		if query == "" then
			local count = 0
			for _ in pairs(trade.Values) do
				count = count + 1
			end
			for _ in pairs(trade.PetValues) do
				count = count + 1
			end
			resultText.Text = "Type an item name above (e.g. evergun, harvester, zombie dog).\n" .. count .. " items have a value."
			return
		end
		for key, value in pairs(trade.Values) do
			if query == "" or string.find(key, query, 1, true) then
				table.insert(found, { Name = trade.Names[key] or key, Value = value })
			end
		end
		for key, name in pairs(trade.New) do
			if query ~= "" and string.find(key, query, 1, true) then
				table.insert(found, { Name = name .. " (NEW — no value yet)", Value = -1 })
			end
		end
		for key, value in pairs(trade.PetValues) do
			if query == "" or string.find(key, query, 1, true) then
				table.insert(found, { Name = trade.Names["pet:" .. key] or key, Value = value })
			end
		end
		table.sort(found, function(a, b)
			return a.Value > b.Value
		end)
		local lines = {}
		for i = 1, math.min(#found, 12) do
			local value = found[i].Value
			table.insert(lines, value < 0 and found[i].Name
				or value >= CONFIG.PricelessFrom and (found[i].Name .. "  —  PRICELESS (1 of 1)")
				or (found[i].Name .. "  —  " .. formatNumber(value)))
		end
		if #found == 0 then
			lines[1] = "No value for that item yet — set it below"
		elseif #found > 12 then
			table.insert(lines, "... and " .. (#found - 12) .. " more, type more letters")
		end
		resultText.Text = table.concat(lines, "\n")
	end
	searchBox:GetPropertyChangedSignal("Text"):Connect(showSearch)
	showSearch()

	section(tradePage, "Current Trade")
	local verdictCard = card(tradePage, 46)
	local verdictLabel = label({
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(1, -32, 1, 0),
		Text = "No trade open",
		Font = FONT_BOLD,
		TextSize = 15,
		TextColor3 = COMMON.SubText,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = verdictCard,
	})
	local _, tradeText = paragraph(tradePage, "Items", "Open a trade in MM2 — the items and their values show up here.")
	local debugFrame, debugText = paragraph(tradePage, "Debug: raw trade data", "")
	debugFrame.Visible = false

	-- small box at the top of the screen while you trade (the menu can stay closed)
	local overlay = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(320, 48),
		BackgroundColor3 = COMMON.Black,
		BackgroundTransparency = 0.25,
		Visible = false,
		ZIndex = 50,
		Parent = gui,
	})
	corner(overlay, 10)
	stroke(overlay, 0.6, 1)
	local overlayTop = label({
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -20, 0, 18),
		Text = "",
		Font = FONT_MEDIUM,
		TextSize = 13,
		TextColor3 = COMMON.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 51,
		Parent = overlay,
	})
	local overlayVerdict = label({
		Position = UDim2.fromOffset(10, 23),
		Size = UDim2.new(1, -20, 0, 20),
		Text = "",
		Font = FONT_BOLD,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 51,
		Parent = overlay,
	})

	-- MM2 puts its own font on every text (A turns into a star). A font set inside
	-- rich text can't be changed by the game, so the trade texts use it
	local GOTHAM = "rbxasset://fonts/families/GothamSSm.json"
	pcall(function()
		GOTHAM = Font.fromEnum(Enum.Font.Gotham).Family
	end)
	local function setText(textLabel, text, bold)
		text = string.gsub(text, "&", "&amp;")
		text = string.gsub(text, "<", "&lt;")
		text = string.gsub(text, ">", "&gt;")
		textLabel.RichText = true
		textLabel.Text = '<font family="' .. GOTHAM .. '" weight="' .. (bold and "Bold" or "Medium") .. '">' .. text .. "</font>"
	end

	local function show()
		local now = trade.Current
		if not now then
			setText(verdictLabel, "No trade open", true)
			verdictLabel.TextColor3 = COMMON.SubText
			setText(tradeText, "Open a trade in MM2 — the items and their values show up here.")
			overlay.Visible = false
			return
		end
		local give, get = now.Give, now.Get
		local difference = get.Total - give.Total
		local approx = (give.Guessed + get.Guessed > 0) and "≈" or ""
		local text, color
		if now.Verdict == "profit" then
			local percent = give.Total > 0 and (" (+" .. math.floor(difference / give.Total * 100 + 0.5) .. "%)") or " (free items)"
			text, color = "✔ PROFIT  " .. approx .. "+" .. formatNumber(difference) .. percent, COMMON.Green
		elseif now.Verdict == "loss" then
			if difference > 0 then
				text = "✖ NOT ENOUGH  " .. approx .. "+" .. formatNumber(difference) .. " (need +" .. trade.MinProfit .. "%)"
			else
				text = "✖ LOSS  " .. approx .. formatNumber(difference)
			end
			color = COMMON.Close
		elseif now.Verdict == "unknown" then
			text, color = "? " .. (give.Unknown + get.Unknown) .. " item(s) without a value", YELLOW
		else
			text, color = "Waiting for items...", COMMON.SubText
		end
		if now.Note then
			text = text .. "  •  " .. now.Note
		end
		setText(verdictLabel, text, true)
		verdictLabel.TextColor3 = color
		local lines = { "Trading with " .. now.With, "", "You give (" .. approx .. formatNumber(give.Total) .. "):" }
		for _, line in ipairs(give.Lines) do
			table.insert(lines, line)
		end
		if #give.Lines == 0 then
			table.insert(lines, "  nothing")
		end
		table.insert(lines, "")
		table.insert(lines, "You get (" .. approx .. formatNumber(get.Total) .. "):")
		for _, line in ipairs(get.Lines) do
			table.insert(lines, line)
		end
		if #get.Lines == 0 then
			table.insert(lines, "  nothing")
		end
		setText(tradeText, table.concat(lines, "\n"))
		overlay.Visible = trade.Overlay
		setText(overlayTop, "Give " .. approx .. formatNumber(give.Total) .. "   •   Get " .. approx .. formatNumber(get.Total))
		setText(overlayVerdict, text, true)
		overlayVerdict.TextColor3 = color
	end

	local function onUpdate(data)
		if type(data) ~= "table" then
			return
		end
		debugText.Text = string.sub(dump(data), 1, 1500)
		-- which side is yours: Player1 / Player2 with .Player (or the player's name)
		local mine, theirs
		for _, side in pairs(data) do
			if type(side) == "table" then
				local who = side.Player or side.player
				if who ~= nil then
					if who == player or who == player.Name or who == player.UserId then
						mine = side
					else
						theirs = side
					end
				end
			end
		end
		if not mine or not theirs then
			return
		end
		trade.LastData = data
		trade.Stamp = trade.Stamp + 1
		local stamp = trade.Stamp
		local myOffer = mine.Offer or mine.Items or mine.Offers
		local give = addUp(myOffer)
		local get = addUp(theirs.Offer or theirs.Items or theirs.Offers, true)
		local partner = theirs.Player or theirs.player
		local other, partnerId = partner, nil
		if type(partner) == "string" then
			partner = Players:FindFirstChild(partner) or partner
		end
		pcall(function()
			other = partner.DisplayName -- a Player: show the display name
			partnerId = tonumber(partner.UserId)
		end)
		local now = {
			With = type(other) == "string" and other or tostring(other),
			Player = partnerId and partner or nil,
			UserId = partnerId,
			Give = give,
			Get = get,
			Verdict = judge(give, get),
		}
		trade.Current = now
		show()
	end

	local function tradeOver(message)
		if trade.Current then
			trade.Current = nil
			trade.Stamp = trade.Stamp + 1
			show()
			if message then
				farmNotify("Trade", message, 3)
			end
		end
	end
	trade.Decline = function(message)
		if trade.Remotes.DeclineTrade then
			pcall(function()
				trade.Remotes.DeclineTrade:FireServer()
			end)
		end
		tradeOver(message)
	end

	-- MM2 sends every change of the trade to you through ReplicatedStorage.Trade
	task.spawn(function()
		pcall(function()
			local folder = game:GetService("ReplicatedStorage"):WaitForChild("Trade", 60)
			if not folder then
				return
			end
			for _, name in ipairs({ "UpdateTrade", "AcceptTrade", "DeclineTrade" }) do
				trade.Remotes[name] = folder:WaitForChild(name, 10)
			end
			for _, name in ipairs({ "SendRequest", "OfferItem", "RemoveOffer", "StartTrade", "AcceptRequest", "CancelRequest" }) do
				trade.Remotes[name] = folder:FindFirstChild(name)
			end
		end)
		local remotes = trade.Remotes
		if remotes.UpdateTrade then
			remotes.UpdateTrade.OnClientEvent:Connect(onUpdate)
		end
		if remotes.StartTrade and remotes.StartTrade:IsA("RemoteEvent") then
			remotes.StartTrade.OnClientEvent:Connect(function(data)
				onUpdate(data)
			end)
		end
		if remotes.DeclineTrade then
			remotes.DeclineTrade.OnClientEvent:Connect(function()
				tradeOver("The trade was declined")
			end)
		end
		if remotes.AcceptTrade then
			remotes.AcceptTrade.OnClientEvent:Connect(function(complete)
				if complete then
					if trade.OnComplete and trade.Current then
						trade.OnComplete(trade.Current)
					end
					tradeOver("The trade is done")
				end
			end)
		end
	end)

	section(tradePage, "Settings")
	trade.Sliders.MinProfit = slider(tradePage, "Min Profit", 0, 100, trade.MinProfit, " %", function(value)
		trade.MinProfit = value
		if trade.LastData and trade.Current then
			onUpdate(trade.LastData)
		end
	end)
	toggle(tradePage, nil, "Guess Unknown Items", "No value? Count it by rarity (Godly, Chroma...) — marked ≈", trade.Estimates, function(enabled)
		trade.Estimates = enabled
		if trade.LastData and trade.Current then
			onUpdate(trade.LastData)
		end
	end)
	toggle(tradePage, nil, "Trade Box On Screen", "Give / get / profit at the top while trading", trade.Overlay, function(enabled)
		trade.Overlay = enabled
		show()
	end)
	toggle(tradePage, nil, "Debug", "Show the raw trade data (send me a screenshot if items are missing)", false, function(enabled)
		debugFrame.Visible = enabled
	end)


	section(tradePage, "Fix A Value")

	-- set / fix a value: [name] [value] [Save]
	local setCard = card(tradePage, 44)
	local nameBox = create("TextBox", {
		Position = UDim2.fromOffset(8, 7),
		Size = UDim2.new(1, -170, 0, 30),
		BackgroundColor3 = THEME.Field,
		ClearTextOnFocus = false,
		Text = "",
		PlaceholderText = "Item name",
		PlaceholderColor3 = THEME.IconTint,
		TextColor3 = COMMON.Text,
		Font = FONT_MEDIUM,
		TextSize = 13,
		Parent = setCard,
	})
	corner(nameBox, 8)
	paint(nameBox, "BackgroundColor3", "Field")
	local valueBox = create("TextBox", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -66, 0, 7),
		Size = UDim2.fromOffset(90, 30),
		BackgroundColor3 = THEME.Field,
		ClearTextOnFocus = false,
		Text = "",
		PlaceholderText = "Value",
		PlaceholderColor3 = THEME.IconTint,
		TextColor3 = COMMON.Text,
		Font = FONT_MEDIUM,
		TextSize = 13,
		Parent = setCard,
	})
	corner(valueBox, 8)
	paint(valueBox, "BackgroundColor3", "Field")
	local setButton = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 7),
		Size = UDim2.fromOffset(54, 30),
		BackgroundColor3 = COMMON.Green,
		AutoButtonColor = false,
		Text = "Save",
		Font = FONT_BOLD,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(14, 30, 18),
		Parent = setCard,
	})
	corner(setButton, 8)
	-- the line for CONFIG.MM2Values, so the value stays in the script forever
	local codeBox = create("TextBox", {
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundColor3 = COMMON.Black,
		BackgroundTransparency = 0.5,
		ClearTextOnFocus = false,
		TextEditable = false,
		Text = "",
		TextColor3 = COMMON.Green,
		Font = Enum.Font.Code,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = nextOrder(),
		Visible = false,
		Parent = tradePage,
	})
	corner(codeBox, 8)
	padding(codeBox, 0, 8, 0, 8)

	setButton.MouseButton1Click:Connect(function()
		local name = string.gsub(string.gsub(nameBox.Text, "^%s+", ""), "%s+$", "")
		local value = tonumber((string.gsub(valueBox.Text, "[%s,]", "")))
		if name == "" or not value then
			notify("Set value", "Type the item name and a number", 3)
			return
		end
		name = string.gsub(name, '"', "'")
		setValue(name, value)
		trade.Custom[name] = value
		local saved = saveCustom()
		codeBox.Text = string.format('["%s"] = %d,', name, value)
		codeBox.Visible = true
		nameBox.Text = ""
		valueBox.Text = ""
		showSearch()
		notify("Value saved", name .. " = " .. formatNumber(value) .. (saved and " (kept for next time)" or ""), 3)
		if trade.LastData and trade.Current then
			onUpdate(trade.LastData) -- count the trade again with the new value
		end
	end)

	paragraph(tradePage, "Tips", "Type any item at the top to see its value. While you trade, the box at the top "
		.. "of the screen shows what you give, what you get and PROFIT / LOSS. Values are community estimates "
		.. "and change every week — fix one with Fix A Value. ≈ means a guess by rarity. Works in Murder Mystery 2.")
end

-- Themes
local themesPage = createTab("Themes", "◆", "Change the look of the menu")
section(themesPage, "Choose a theme")

local themeGrid = create("Frame", {
	Size = UDim2.new(1, 0, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundTransparency = 1,
	LayoutOrder = nextOrder(),
	Parent = themesPage,
})
create("UIGridLayout", {
	CellSize = UDim2.new(0.5, -6, 0, 96),
	CellPadding = UDim2.fromOffset(12, 12),
	SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = themeGrid,
})

local themeCards = {}
state.autoThemeEnabled = false

local function refreshThemeCards(duration)
	for _, themeCard in ipairs(themeCards) do
		local active = themeCard.Theme == currentTheme
		tween(themeCard.Stroke, duration, { Transparency = active and 0 or 0.85, Thickness = active and 2 or 1 })
		themeCard.Badge.Visible = active
	end
end

-- each card shows the theme in its own colors (it is not repainted)
for index, theme in ipairs(THEMES) do
	local button = create("TextButton", {
		BackgroundColor3 = theme.Window,
		BackgroundTransparency = 0.05,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = index,
		Parent = themeGrid,
	})
	corner(button, 12)
	local cardScale = create("UIScale", { Parent = button })
	local cardStroke = stroke(button, 0.85, 1, theme.Accent)

	-- accent preview
	local swatch = create("Frame", {
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.new(1, -24, 0, 32),
		BackgroundColor3 = COMMON.White,
		Parent = button,
	})
	corner(swatch, 8)
	create("UIGradient", { Color = ColorSequence.new(theme.Accent, theme.Accent2), Parent = swatch })

	local badge = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = COMMON.Black,
		BackgroundTransparency = 0.45,
		Visible = false,
		Parent = swatch,
	})
	round(badge)
	padding(badge, 0, 9, 0, 9)
	label({
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "ACTIVE",
		Font = FONT_BOLD,
		TextSize = 11,
		TextColor3 = COMMON.White,
		Parent = badge,
	})

	label({
		Position = UDim2.fromOffset(14, 54),
		Size = UDim2.new(1, -90, 0, 20),
		Text = theme.Name,
		Font = FONT_BOLD,
		TextSize = 15,
		TextColor3 = COMMON.Text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = button,
	})
	label({
		Position = UDim2.fromOffset(14, 73),
		Size = UDim2.new(1, -90, 0, 14),
		Text = "Click to apply",
		Font = FONT_REGULAR,
		TextSize = 12,
		TextColor3 = theme.IconTint,
		Parent = button,
	})

	-- small color dots: card, field, icons
	for dotIndex, color in ipairs({ theme.Card, theme.Field, theme.IconTint }) do
		local dot = create("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12 - (3 - dotIndex) * 20, 0, 70),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = color,
			Parent = button,
		})
		round(dot)
		stroke(dot, 0.8, 1)
	end

	button.MouseEnter:Connect(function()
		tween(cardScale, 0.25, { Scale = 1.03 })
	end)
	button.MouseLeave:Connect(function()
		tween(cardScale, 0.25, { Scale = 1 })
	end)
	button.MouseButton1Click:Connect(function()
		if setTheme(theme.Name) then
			notify("Theme changed", theme.Name .. " is on now", 3)
		end
	end)

	table.insert(themeCards, { Theme = theme, Stroke = cardStroke, Badge = badge })
end

onTheme(function(instant)
	refreshThemeCards(instant and 0 or 0.35)
end)

section(themesPage, "Extra")
toggle(themesPage, nil, "Auto Theme", "Themes change every " .. CONFIG.AutoThemeDelay .. " seconds", false, function(enabled)
	state.autoThemeEnabled = enabled
	if enabled then
		notify("Auto Theme enabled", "Sit back and watch the colors", 3)
	else
		notify("Auto Theme disabled", currentTheme.Name .. " stays on", 3)
	end
end)

-- Auto Theme: go to the next theme in the list
task.spawn(function()
	while gui.Parent do
		task.wait(CONFIG.AutoThemeDelay)
		if state.autoThemeEnabled then
			local nextIndex = (table.find(THEMES, currentTheme) or 0) % #THEMES + 1
			setTheme(THEMES[nextIndex].Name)
		end
	end
end)

