---------------------------------------------------------------------
-- FEATURES: FLY
---------------------------------------------------------------------
state.flyEnabled = CONFIG.Fly
state.flySpeed = CONFIG.FlySpeed
local flight = nil -- current flight data (nil = not flying)
-- Fly settings (Settings tab)
state.flyPose = true -- Superman pose for arms and legs
state.flyTilt = true -- the body leans in the flying direction
state.flyBob = true -- gentle up-and-down bobbing while hovering
state.flyFollowCamera = true -- fly up / down where the camera looks

local keyDown -- defined below, used by other parts of the menu

do -- Fly internals (kept local to save variables)
	-- if the game has the W1MIW_FlyServer server script, everyone sees the Superman pose
	local poseRemote = nil
	task.spawn(function()
		poseRemote = game:GetService("ReplicatedStorage"):WaitForChild("W1MIW_FlyPose", 15)
	end)
	local baseC0 = setmetatable({}, { __mode = "k" }) -- normal joint positions

	-- joint poses (angles in radians around the torso axes, work for both R6 and R15)
	-- X: + forward / up, − back;  Z: sideways
	-- Hover = hovering in place, Fly = Superman at full speed
	local JOINTS = {
		-- head up, looking in the flying direction
		{ Key = "Neck", Names = { "Neck" }, Hover = Vector3.new(0.1, 0, 0), Fly = Vector3.new(1.1, 0, 0), Phase = 0 },
		-- right fist stretched forward, like Superman
		{ Key = "RightArm", Names = { "RightShoulder", "Right Shoulder" }, Hover = Vector3.new(0.2, 0, 0.5), Fly = Vector3.new(math.pi, 0, -0.15), Phase = 0.5 },
		-- left arm close to the body
		{ Key = "LeftArm", Names = { "LeftShoulder", "Left Shoulder" }, Hover = Vector3.new(0.2, 0, -0.5), Fly = Vector3.new(-0.2, 0, 0.05), Phase = 2.1 },
		-- legs straight back and together
		{ Key = "RightLeg", Names = { "RightHip", "Right Hip" }, Hover = Vector3.new(-0.15, 0, 0.12), Fly = Vector3.new(-0.15, 0, -0.04), Phase = 1.3 },
		{ Key = "LeftLeg", Names = { "LeftHip", "Left Hip" }, Hover = Vector3.new(0.35, 0, -0.12), Fly = Vector3.new(-0.15, 0, 0.04), Phase = 3.4 },
		-- on R15 the right knee is slightly bent, the classic Superman pose (R6 has no knees)
		{ Key = "RightKnee", Names = { "RightKnee" }, Hover = Vector3.new(-0.2, 0, 0), Fly = Vector3.new(-0.55, 0, 0), Phase = 1.3 },
		{ Key = "LeftKnee", Names = { "LeftKnee" }, Hover = Vector3.new(-0.1, 0, 0), Fly = Vector3.new(0, 0, 0), Phase = 3.4 },
	}

	local function findJoints(character)
		local found = {}
		for _, object in ipairs(character:GetDescendants()) do
			if object:IsA("Motor6D") then
				for _, info in ipairs(JOINTS) do
					if not found[info.Key] and table.find(info.Names, object.Name) then
						if not baseC0[object] then
							baseC0[object] = object.C0
						end
						found[info.Key] = { Motor = object, C0 = baseC0[object], Info = info }
					end
				end
			end
		end
		local list = {}
		for _, joint in pairs(found) do
			table.insert(list, joint)
		end
		return list
	end

	local function isTyping()
		return UserInputService:GetFocusedTextBox() ~= nil
	end

	function keyDown(...)
		if isTyping() then
			return false
		end
		for _, key in ipairs({ ... }) do
			if UserInputService:IsKeyDown(key) then
				return true
			end
		end
		return false
	end

	local function flatten(vector, minimum)
		local flat = Vector3.new(vector.X, 0, vector.Z)
		if flat.Magnitude > (minimum or 0.05) then
			return flat.Unit
		end
		return nil
	end

	local function startFlight(character, humanoid, root)
		local objects = {}
		local function add(instance)
			table.insert(objects, instance)
			return instance
		end

		local attachment = add(create("Attachment", { Name = "W1MIW_Fly", Parent = root }))
		local mover = add(create("LinearVelocity", {
			Attachment0 = attachment,
			RelativeTo = Enum.ActuatorRelativeTo.World,
			VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
			MaxForce = math.huge,
			VectorVelocity = Vector3.zero,
			Parent = root,
		}))
		local align = add(create("AlignOrientation", {
			Attachment0 = attachment,
			Mode = Enum.OrientationAlignmentMode.OneAttachment,
			MaxTorque = math.huge,
			Responsiveness = 22,
			CFrame = root.CFrame.Rotation,
			Parent = root,
		}))

		humanoid.Sit = false
		humanoid.PlatformStand = true

		-- real flying animation: Roblox shows it to all players by itself
		local track = nil
		if CONFIG.FlyAnimationId ~= "" then
			local animator = humanoid:FindFirstChildOfClass("Animator")
			if animator then
				local animation = add(create("Animation", { AnimationId = CONFIG.FlyAnimationId }))
				local ok, result = pcall(function()
					return animator:LoadAnimation(animation)
				end)
				if ok and result then
					track = result
					track.Priority = Enum.AnimationPriority.Action4
					track.Looped = true
					track:Play(0.25)
				end
			end
		end

		local startVelocity = root.AssemblyLinearVelocity
		if startVelocity.Magnitude > state.flySpeed * 2 then
			startVelocity = startVelocity.Unit * state.flySpeed * 2
		end

		flight = {
			Character = character,
			Humanoid = humanoid,
			Root = root,
			Mover = mover,
			Align = align,
			Objects = objects,
			Joints = findJoints(character),
			Velocity = startVelocity, -- falling speed fades out smoothly
			Time = 0,
			PoseWeight = 0,
			LastJump = 0,
			Track = track,
			SentAmount = -1, -- last pose sent to the server
			SentTime = 0,
		}
	end

	local function stopFlight()
		local data = flight
		flight = nil
		if not data then
			return
		end
		if data.Track then
			data.Track:Stop(0.25)
		end
		if poseRemote and data.SentAmount >= 0 then
			poseRemote:FireServer(false)
		end
		for _, joint in ipairs(data.Joints) do
			if joint.Motor.Parent then
				joint.Motor.C0 = joint.C0
			end
		end
		for _, object in ipairs(data.Objects) do
			object:Destroy()
		end
		if data.Humanoid.Parent then
			data.Humanoid.PlatformStand = false
			if data.Humanoid.Health > 0 then
				data.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end
		if data.Root.Parent then
			data.Root.AssemblyLinearVelocity = data.Velocity * 0.4
		end
	end

	-- where to fly: camera + WASD / joystick, up and down with separate keys
	local function flightDirection()
		local cam = workspace.CurrentCamera
		local move = Vector3.zero
		local strafe = 0

		-- MoveDirection already includes WASD and the joystick, but it is flat (horizontal):
		-- split it into "forward" and "sideways" relative to the camera and add the camera pitch,
		-- so you can fly up and down just by looking there
		local moveDirection = flight.Humanoid.MoveDirection
		move = moveDirection
		if cam then
			local flatLook = flatten(cam.CFrame.LookVector)
			local flatRight = flatten(cam.CFrame.RightVector)
			if flatLook and flatRight then
				local forward = moveDirection:Dot(flatLook)
				strafe = moveDirection:Dot(flatRight)
				if state.flyFollowCamera then
					move = cam.CFrame.LookVector * forward + cam.CFrame.RightVector * strafe
				else
					-- flat flying: height changes only with Space / Ctrl
					move = flatLook * forward + flatRight * strafe
				end
			end
		end

		local vertical = 0
		if keyDown(Enum.KeyCode.Space) or os.clock() - flight.LastJump < 0.15 then
			vertical = vertical + 1
		end
		if keyDown(Enum.KeyCode.LeftControl) then
			vertical = vertical - 1
		end

		local direction = move + Vector3.new(0, vertical, 0)
		if direction.Magnitude > 1 then
			direction = direction.Unit
		end
		return direction, strafe
	end

	local function updateFlight(dt)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = humanoid and humanoid.RootPart
		local alive = root ~= nil and humanoid.Health > 0

		-- turned off, died or got a new character: land safely
		if flight and (not state.flyEnabled or not alive or flight.Character ~= character or flight.Root ~= root) then
			stopFlight()
		end
		if state.flyEnabled and alive and not flight then
			startFlight(character, humanoid, root)
		end
		if not flight then
			return
		end

		flight.Time = flight.Time + dt
		humanoid.PlatformStand = true

		local direction, strafe = flightDirection()
		local smooth = 1 - math.exp(-dt * 6)
		flight.Velocity = flight.Velocity:Lerp(direction * state.flySpeed, smooth)

		local velocity = flight.Velocity
		local speed = velocity.Magnitude
		-- 0 = hovering, 1 = Superman pose (fully reached at 60% speed)
		local amount = math.clamp(speed / math.max(state.flySpeed * 0.6, 1), 0, 1)
		flight.PoseWeight = flight.PoseWeight + (1 - flight.PoseWeight) * smooth
		local weight = flight.PoseWeight

		-- gentle up-and-down bobbing while hovering
		local bob = state.flyBob and math.cos(flight.Time * 2.2) * 1.1 * (1 - amount) * weight or 0
		flight.Mover.VectorVelocity = velocity + Vector3.new(0, bob, 0)

		-- turn and tilt the body in the flying direction
		local cam = workspace.CurrentCamera
		local yaw = (speed > 2 and flatten(velocity, 2))
			or (cam and flatten(cam.CFrame.LookVector))
			or flatten(flight.Root.CFrame.LookVector)
			or Vector3.new(0, 0, -1)
		local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		local elevation = math.atan2(velocity.Y, horizontalSpeed)
		-- the body lies flat, head first
		local tiltWeight = state.flyTilt and amount * weight or 0
		local tilt = math.clamp(math.pi / 2 - elevation, 0, math.rad(95)) * tiltWeight
		local roll = -strafe * 0.35 * tiltWeight
		flight.Align.CFrame = CFrame.lookAt(Vector3.zero, yaw) * CFrame.Angles(-tilt, 0, roll)

		-- if a custom animation is playing, it controls the arms and legs
		if flight.Track then
			if not flight.Track.IsPlaying then
				flight.Track:Play(0.25)
			end
			return
		end

		-- pose turned off in the settings: arms and legs stay normal
		if not state.flyPose then
			if poseRemote and flight.SentAmount >= 0 then
				flight.SentAmount = -1
				poseRemote:FireServer(false)
			end
			for _, joint in ipairs(flight.Joints) do
				if joint.Motor.Parent then
					joint.Motor.C0 = joint.C0
				end
			end
			return
		end

		-- tell the server the pose so everyone sees it (at most 10 times per second)
		if poseRemote then
			local rounded = math.floor(amount * 10 + 0.5) / 10
			local now = os.clock()
			if rounded ~= flight.SentAmount and now - flight.SentTime > 0.1 then
				flight.SentAmount = rounded
				flight.SentTime = now
				poseRemote:FireServer(rounded)
			end
		end

		-- pose: smooth blend from hovering to Superman + arm and leg sway
		for _, joint in ipairs(flight.Joints) do
			if joint.Motor.Parent then
				local info = joint.Info
				local angles = info.Hover:Lerp(info.Fly, amount)
				local wave = math.sin(flight.Time * 2.4 + info.Phase) * 0.1 * (1 - amount)
					+ math.sin(flight.Time * 15 + info.Phase) * 0.02 * amount
				angles = (angles + Vector3.new(wave, 0, wave * 0.5)) * weight
				local base = joint.C0
				joint.Motor.C0 = CFrame.new(base.Position) * CFrame.Angles(angles.X, angles.Y, angles.Z) * base.Rotation
			end
		end
	end

	RunService.RenderStepped:Connect(updateFlight)
end

---------------------------------------------------------------------
-- FEATURES: SPEED
---------------------------------------------------------------------
-- While Speed is on, your WalkSpeed is kept at the chosen value every frame
-- (some games reset it, so it is set again). When turned off, the old speed comes back.
state.speedEnabled = CONFIG.Speed
state.walkSpeed = CONFIG.WalkSpeed
local restoreSpeed -- defined below, used by other parts of the menu

do -- Speed internals (kept local to save variables)
	local speedHumanoid = nil -- the humanoid we changed
	local speedOriginal = 16 -- its speed before Speed was turned on
	state.speedShiftOnly = false -- Settings: fast only while Shift is held

	function restoreSpeed()
		if speedHumanoid and speedHumanoid.Parent then
			speedHumanoid.WalkSpeed = speedOriginal
		end
		speedHumanoid = nil
	end

	RunService.Heartbeat:Connect(function()
		if not state.speedEnabled then
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		if humanoid ~= speedHumanoid then
			-- new character (respawn): remember its normal speed
			speedHumanoid = humanoid
			speedOriginal = humanoid.WalkSpeed
		end
		local target = state.walkSpeed
		if state.speedShiftOnly and not keyDown(Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift) then
			target = speedOriginal
		end
		if humanoid.WalkSpeed ~= target then
			humanoid.WalkSpeed = target
		end
	end)
end

---------------------------------------------------------------------
-- FEATURES: ANTI-FLING
---------------------------------------------------------------------
-- "Fling" is when another player spins like crazy and rams into you
-- to launch you off the map. Two layers of protection:
--   1) other characters don't collide with you (changed only on your side,
--      other players don't notice anything)
--   2) if you still get launched, your speed is reset
--      and you are moved back to where you were
state.antiFlingEnabled = CONFIG.AntiFling
local restoreCollisions -- defined below, used by other parts of the menu

do -- Anti-Fling internals (kept local to save variables)
	local MAX_SPIN = 60 -- rad/s: no normal character spins faster than this
	local suspicious = 0 -- frames in a row that looked like a fling
	local savedCollision = setmetatable({}, { __mode = "k" }) -- original CanCollide of other players' parts
	local safePivot = nil -- last calm position
	local safeCharacter = nil
	local lastFlingNotice = 0
	-- Anti-Fling settings (Settings tab)
	state.antiFlingGhost = true -- layer 1: walk through other players
	state.antiFlingReturn = true -- layer 2: move back to the last safe spot
	state.antiFlingNotify = true -- show "Fling blocked"

	function restoreCollisions()
		for part, canCollide in pairs(savedCollision) do
			if part.Parent then
				part.CanCollide = canCollide
			end
		end
		table.clear(savedCollision)
	end

	-- 1) every frame before physics, turn off collisions with other characters
	RunService.Stepped:Connect(function()
		if not state.antiFlingEnabled or not state.antiFlingGhost then
			return
		end
		for _, other in ipairs(Players:GetPlayers()) do
			local character = other ~= player and other.Character
			if character then
				for _, part in ipairs(character:GetChildren()) do
					if part:IsA("BasePart") then
						if savedCollision[part] == nil then
							savedCollision[part] = part.CanCollide
						end
						part.CanCollide = false
					end
				end
			end
		end
	end)

	-- 2) after physics, check whether we got flung
	RunService.Heartbeat:Connect(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = humanoid and humanoid.RootPart
		if not state.antiFlingEnabled or not root or humanoid.Health <= 0 or humanoid.SeatPart then
			safePivot = nil
			return
		end
		if safeCharacter ~= character then
			safeCharacter = character
			safePivot = nil
		end

		local velocity = root.AssemblyLinearVelocity
		local horizontal = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		-- flying and running (even with Speed) stay below this
		local limit = math.max(250, state.flySpeed * 2, (state.speedEnabled and state.walkSpeed or 0) * 2)
		-- falling down is ignored: falling from high up is fast without any fling
		local wild = horizontal > limit or velocity.Y > limit or root.AssemblyAngularVelocity.Magnitude > MAX_SPIN
		-- a real fling lasts: only 3 wild frames in a row count (a quick turn or a bump doesn't)
		suspicious = wild and suspicious + 1 or 0
		local flung = suspicious >= 3

		if flung then
			suspicious = 0
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			if safePivot and state.antiFlingReturn then
				character:PivotTo(safePivot)
			end
			if flight then
				flight.Velocity = Vector3.zero
			end
			if state.antiFlingNotify and os.clock() - lastFlingNotice > 3 then
				lastFlingNotice = os.clock()
				notify("Fling blocked", "Someone tried to fling you", 3)
			end
		elseif not wild then
			safePivot = character:GetPivot() -- only calm frames count as a safe spot
		end
	end)
end

---------------------------------------------------------------------
-- FEATURES: INFINITE JUMP
---------------------------------------------------------------------
-- every jump request (Space, the mobile button) makes the character
-- jump even in mid-air; while flying, jump = up
state.infiniteJumpEnabled = CONFIG.InfiniteJump
state.airJumpPower = 50 -- Settings: how high a jump in mid-air goes (normal jump ≈ 50)

UserInputService.JumpRequest:Connect(function()
	if flight then
		flight.LastJump = os.clock()
		return
	end
	if not state.infiniteJumpEnabled then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		local inAir = humanoid.FloorMaterial == Enum.Material.Air
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		-- in mid-air the push up is set by the Air Jump Power slider
		local root = humanoid.RootPart
		if inAir and root then
			local velocity = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(velocity.X, state.airJumpPower, velocity.Z)
		end
	end
end)

---------------------------------------------------------------------
-- FEATURES: WALLHACK — PLAYER ESP (see players through walls)
---------------------------------------------------------------------
-- Every other player gets a glowing outline that is drawn on top of walls
-- (Highlight with AlwaysOnTop) and, optionally, a name tag with distance and health.
-- Everything is created only on your side: other players don't see it.
-- Note: Roblox draws at most 31 Highlights at the same time.
state.espEnabled = CONFIG.ESP
state.espNames = CONFIG.ESPNames
local espObjects = {} -- [player] = { Character, Highlight, Tag, Name, Info }
-- ESP settings (Settings tab)
state.espFill = 65 -- fill transparency in %, 100 = outline only
state.espOutline = true -- glowing outline around players
state.espTeamCheck = false -- don't show your teammates
state.espTeamColors = false -- color players by their team
state.espMaxDistance = CONFIG.ESPMaxDistance -- farther players are hidden
state.espShowHealth = true -- distance + HP line in name tags
-- Murder Mystery 2
state.roleEsp = CONFIG.RoleESP
state.roleInnocents = CONFIG.RoleESPInnocents
state.gunDropEsp = CONFIG.GunDropESP

local clearEsp -- defined below, used by other parts of the menu

do -- Player ESP internals (kept local to save variables)
	-- Murder Mystery 2: the murderer carries a "Knife", the sheriff (or a hero) a "Gun"
	local ROLE_COLORS = {
		Murderer = Color3.fromRGB(255, 45, 45),
		Sheriff = Color3.fromRGB(45, 140, 255),
		Innocent = Color3.fromRGB(70, 220, 110),
	}
	local roleSeen = {} -- [player] = last role we told you about

	local function hasTool(other, toolName)
		local backpack = other:FindFirstChildOfClass("Backpack")
		local character = other.Character
		local tool = (backpack and backpack:FindFirstChild(toolName)) or (character and character:FindFirstChild(toolName))
		return tool ~= nil and tool:IsA("Tool")
	end

	local function getRole(other)
		if hasTool(other, "Knife") then
			return "Murderer"
		elseif hasTool(other, "Gun") then
			return "Sheriff"
		end
		return "Innocent"
	end

	-- the gun the sheriff drops when he dies is called "GunDrop" in the map
	local gunDrops = {} -- [GunDrop] = { Highlight, Tag }
	local function watchGunDrop(object)
		-- only when you want to see it: nothing is put into MM2's own objects otherwise
		if object.Name ~= "GunDrop" or gunDrops[object] or not (state.roleEsp and state.gunDropEsp) then
			return
		end
		local highlight = create("Highlight", {
			Name = "W1MIW_GunESP",
			Adornee = object,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			FillColor = Color3.fromRGB(255, 215, 40),
			FillTransparency = 0.35,
			OutlineColor = Color3.fromRGB(255, 245, 160),
			Enabled = state.roleEsp and state.gunDropEsp,
			Parent = object,
		})
		local tag = create("BillboardGui", {
			Name = "W1MIW_GunTag",
			AlwaysOnTop = true,
			Size = UDim2.fromOffset(120, 22),
			StudsOffset = Vector3.new(0, 2.5, 0),
			LightInfluence = 0,
			Enabled = state.roleEsp and state.gunDropEsp,
			Adornee = object,
			Parent = object,
		})
		label({
			Size = UDim2.fromScale(1, 1),
			Text = "GUN",
			Font = FONT_BOLD,
			TextSize = 16,
			TextColor3 = Color3.fromRGB(255, 225, 60),
			TextStrokeTransparency = 0.3,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = tag,
		})
		gunDrops[object] = { Highlight = highlight, Tag = tag }
		object.Destroying:Connect(function()
			gunDrops[object] = nil
		end)
		if state.roleEsp and state.gunDropEsp then
			notify("Gun dropped!", "The sheriff's gun is on the map (yellow)", 4)
		end
	end
	workspace.DescendantAdded:Connect(watchGunDrop)
	-- a gun that was already lying there when the script started / Role ESP was turned on
	function state.scanGunDrop()
		local found = workspace:FindFirstChild("GunDrop", true)
		if found then
			watchGunDrop(found)
		end
	end

	local function removeEsp(other)
		local data = espObjects[other]
		if not data then
			return
		end
		espObjects[other] = nil
		data.Highlight:Destroy()
		data.Tag:Destroy()
	end

	function clearEsp()
		for other in pairs(espObjects) do
			removeEsp(other)
		end
	end

	local function createEsp(other, character)
		local highlight = create("Highlight", {
			Name = "W1MIW_ESP",
			Adornee = character,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			FillColor = THEME.Accent,
			FillTransparency = 0.65,
			OutlineColor = THEME.Accent2,
			OutlineTransparency = 0,
			Parent = character,
		})

		local tag = create("BillboardGui", {
			Name = "W1MIW_ESPTag",
			AlwaysOnTop = true,
			Size = UDim2.fromOffset(220, 40),
			StudsOffset = Vector3.new(0, 2.8, 0),
			LightInfluence = 0,
			MaxDistance = CONFIG.ESPMaxDistance,
			Enabled = state.espNames,
			Parent = character,
		})
		local nameLabel = label({
			Size = UDim2.new(1, 0, 0, 20),
			Text = other.DisplayName,
			Font = FONT_BOLD,
			TextSize = 15,
			TextColor3 = THEME.Accent2,
			TextStrokeTransparency = 0.35,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = tag,
		})
		local infoLabel = label({
			Position = UDim2.fromOffset(0, 20),
			Size = UDim2.new(1, 0, 0, 16),
			Text = "",
			Font = FONT_MEDIUM,
			TextSize = 13,
			TextColor3 = COMMON.Text,
			TextStrokeTransparency = 0.35,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = tag,
		})

		local data = {
			Character = character,
			Highlight = highlight,
			Tag = tag,
			Name = nameLabel,
			Info = infoLabel,
		}
		espObjects[other] = data
		return data
	end

	-- recolor the outlines when the theme changes
	onTheme(function()
		for _, data in pairs(espObjects) do
			data.Highlight.FillColor = THEME.Accent
			data.Highlight.OutlineColor = THEME.Accent2
			data.Name.TextColor3 = THEME.Accent2
		end
	end)

	-- every frame: create outlines for new characters and update distance / health
	RunService.RenderStepped:Connect(function()
		-- the dropped gun is shown only with Role ESP
		if not (state.roleEsp and state.gunDropEsp) then
			for object, drop in pairs(gunDrops) do
				drop.Highlight:Destroy()
				drop.Tag:Destroy()
				gunDrops[object] = nil
			end
		end

		local roleMode = state.roleEsp
		if not state.espEnabled and not roleMode then
			return
		end
		local myCharacter = player.Character
		local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player then
				local character = other.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local data = espObjects[other]
				local teammate = state.espTeamCheck and other.Team ~= nil and other.Team == player.Team

				-- Murder Mystery 2 role (only when Role ESP is on)
				local role = roleMode and getRole(other) or nil
				local roleShown = role ~= nil and (role ~= "Innocent" or state.roleInnocents)
				if roleMode and role ~= "Innocent" and roleSeen[other] ~= role then
					notify(role == "Murderer" and "Murderer found!" or "Sheriff found!", other.DisplayName .. " is the " .. string.lower(role), 4)
				end
				roleSeen[other] = role
				-- with only Role ESP on, innocents are hidden (unless Show Innocents)
				local wanted = state.espEnabled or roleShown

				-- respawned, died, teammate or the outline was removed: rebuild / hide it
				if data and (data.Character ~= character or not data.Highlight.Parent or not humanoid or teammate or not wanted) then
					removeEsp(other)
					data = nil
				end
				if humanoid and humanoid.Health > 0 and not data and not teammate and wanted then
					data = createEsp(other, character)
				end

				if data then
					local head = character:FindFirstChild("Head") or humanoid.RootPart
					local distance = (myRoot and head) and math.floor((head.Position - myRoot.Position).Magnitude) or 0
					local visible = distance <= state.espMaxDistance

					-- colors: Murder Mystery 2 role, team or theme
					local fillColor, outlineColor = THEME.Accent, THEME.Accent2
					if roleShown then
						fillColor = ROLE_COLORS[role]
						outlineColor = fillColor:Lerp(COMMON.White, 0.35)
					elseif state.espTeamColors and other.Team then
						fillColor = other.TeamColor.Color
						outlineColor = other.TeamColor.Color:Lerp(COMMON.White, 0.35)
					end
					local highlight = data.Highlight
					highlight.Enabled = visible
					highlight.FillColor = fillColor
					highlight.OutlineColor = outlineColor
					highlight.FillTransparency = state.espFill / 100
					highlight.OutlineTransparency = state.espOutline and 0 or 1

					data.Tag.Adornee = head
					-- the role is always written above murderer / sheriff
					local roleTag = roleShown and role ~= "Innocent"
					data.Tag.Enabled = (state.espNames or roleTag) and visible
					data.Name.Text = roleTag and (other.DisplayName .. "  •  " .. string.upper(role)) or other.DisplayName
					data.Tag.MaxDistance = state.espMaxDistance
					data.Name.TextColor3 = outlineColor
					data.Info.Visible = state.espShowHealth
					data.Info.Text = distance .. " studs  •  " .. math.max(math.floor(humanoid.Health), 0) .. " HP"
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(other)
		removeEsp(other)
		roleSeen[other] = nil
	end)
end

---------------------------------------------------------------------
-- FEATURES: MURDER MYSTERY 2 — AUTO GRAB GUN
---------------------------------------------------------------------
-- When the sheriff dies his gun falls on the map ("GunDrop"). With Auto Grab Gun on,
-- you teleport onto it for a moment, pick it up and teleport back. It does nothing if
-- you are the murderer (he can't take it) or already have the gun.
state.autoGrabGun = CONFIG.AutoGrabGun
state.gunReturn = CONFIG.GunGrabReturn
state.grabbingGun = false -- Auto Farm pauses while this is true

do -- Auto Grab Gun internals (kept local to save variables)
	local function iHave(toolName)
		local backpack = player:FindFirstChildOfClass("Backpack")
		local character = player.Character
		local tool = (backpack and backpack:FindFirstChild(toolName)) or (character and character:FindFirstChild(toolName))
		return tool ~= nil and tool:IsA("Tool")
	end

	local function grabGun(drop)
		if state.grabbingGun or not state.autoGrabGun or not drop.Parent then
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = humanoid and humanoid.RootPart
		if not root or humanoid.Health <= 0 then
			return
		end
		if iHave("Knife") or iHave("Gun") then
			return -- murderer can't pick it up, sheriff already has one
		end

		state.grabbingGun = true
		local back = character:GetPivot()
		local got = false
		for _ = 1, 12 do -- try for about 2.5 seconds
			if not drop.Parent or not character.Parent or humanoid.Health <= 0 then
				break
			end
			local spot = drop:IsA("BasePart") and drop.Position or drop:GetPivot().Position
			root.AssemblyLinearVelocity = Vector3.zero
			character:PivotTo(CFrame.new(spot + Vector3.new(0, 1, 0)) * back.Rotation)
			task.wait(0.2)
			if iHave("Gun") then
				got = true
				break
			end
		end
		if state.gunReturn and character.Parent and humanoid.Health > 0 then
			root.AssemblyLinearVelocity = Vector3.zero
			character:PivotTo(back) -- straight back to where you were
		end
		state.grabbingGun = false
		if got then
			notify("You got the gun!", "You are the sheriff now", 4)
		else
			notify("Couldn't grab the gun", "Someone was faster", 3)
		end
	end

	workspace.DescendantAdded:Connect(function(object)
		if object.Name == "GunDrop" and state.autoGrabGun then
			task.delay(0.2, grabGun, object) -- let it land first
		end
	end)

	-- a gun that is already lying there when you switch Auto Grab Gun on
	function state.grabGunNow()
		local drop = workspace:FindFirstChild("GunDrop", true)
		if drop then
			task.spawn(grabGun, drop)
		end
	end
end

---------------------------------------------------------------------
-- FEATURES: WALLHACK — NOCLIP (walk through walls)
---------------------------------------------------------------------
-- Every frame before physics your own character parts stop colliding,
-- so you walk (and fly) straight through walls. You still stand on the floor:
-- the Humanoid keeps you up by itself. When turned off, collisions come back.
state.noclipEnabled = CONFIG.Noclip
local restoreNoclip -- defined below, used by other parts of the menu

do -- Noclip internals (kept local to save variables)
	local noclipSaved = setmetatable({}, { __mode = "k" }) -- original CanCollide of your parts
	state.noclipFlyOnly = false -- Settings: Noclip works only while flying

	function restoreNoclip()
		for part, canCollide in pairs(noclipSaved) do
			if part.Parent then
				part.CanCollide = canCollide
			end
		end
		table.clear(noclipSaved)
	end

	RunService.Stepped:Connect(function()
		local active = (state.noclipEnabled and (not state.noclipFlyOnly or flight ~= nil)) or state.farmOn or state.mimicOn -- Auto Farm and Mimic go through walls
		if not active then
			-- e.g. "only while flying" and you just landed: walls are solid again
			if next(noclipSaved) then
				restoreNoclip()
			end
			return
		end
		local character = player.Character
		if not character then
			return
		end
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				if noclipSaved[part] == nil then
					noclipSaved[part] = part.CanCollide
				end
				part.CanCollide = false
			end
		end
	end)
end

-- the script was started again: the old copy gives your character back as it was
table.insert(state.onClose, function()
	restoreSpeed()
	restoreCollisions()
	restoreNoclip()
	pcall(function()
		RunService:UnbindFromRenderStep("W1MIW_Aimbot")
	end)
end)

---------------------------------------------------------------------
-- FEATURES: AIMBOT
---------------------------------------------------------------------
-- While the right mouse button is held, the camera turns so the target ends up
-- exactly under your cursor (or in the screen center). Works in first person,
-- third person and Shift Lock:
--   • in third person the Roblox camera orbits around your head, so the aim is
--     solved for that orbit — otherwise the camera would shake every frame
--   • most guns shoot where the cursor points, so the target is put under the
--     cursor, not just somewhere in the middle of the screen
-- Once locked, it stays on that target until it dies, hides or leaves the screen.
state.aimbotEnabled = CONFIG.Aimbot
state.aimHold = true -- aim only while the right mouse button is held
state.aimFov = CONFIG.AimFOV
state.aimShowFov = true -- draw the FOV circle
state.aimSmooth = CONFIG.AimSmoothness
state.aimHead = true -- true = head, false = body
state.aimCursor = CONFIG.AimAtCursor -- true = target under the cursor, false = screen center
state.aimPrediction = CONFIG.AimPrediction -- ms: aim ahead of moving targets
state.aimWallCheck = CONFIG.AimWallCheck -- false = aim through walls
state.aimTeamCheck = false -- ignore teammates
state.aimNpcs = CONFIG.AimNPCs -- also aim at NPCs and dummies (handy for testing alone)
state.aimMoveCursor = CONFIG.AimMoveCursor -- free cursor: move the cursor, not the camera
state.aimShootSnap = CONFIG.AimShootSnap -- cursor mode: turn the camera while shooting so bullets hit
state.aimShowShotPoint = false -- red dot where the game's mouse.Hit really points
state.aimMaxDistance = CONFIG.AimMaxDistance
state.aimTarget = nil -- the character model we are locked on

do -- Aimbot internals (kept local to save variables)
	local fovCircle = create("Frame", {
		Name = "AimFOV",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(state.aimFov * 2, state.aimFov * 2),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 0, -- under the menu window
		Parent = gui,
	})
	round(fovCircle)
	local fovStroke = stroke(fovCircle, 0.2, 1.5, THEME.Accent)
	local targetLabel = label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 6),
		Size = UDim2.fromOffset(220, 18),
		Text = "",
		Font = FONT_BOLD,
		TextSize = 13,
		TextStrokeTransparency = 0.4,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = fovCircle,
	})

	-- Cursor mode. Roblox scripts can't move the real mouse, so while locked the
	-- real cursor is hidden and an exact copy of it (the same picture) slides onto
	-- the target. The camera doesn't move. Your own guns can shoot at _G.W1MIW_AimPosition
	local DEFAULT_CURSOR = "rbxasset://textures/Cursors/KeyboardMouse/ArrowFarCursor.png"
	local mouseObject = player:GetMouse()
	local aimCursor = create("ImageLabel", {
		Name = "AimCursor",
		AnchorPoint = Vector2.new(0.5, 0.5), -- Roblox centers cursor pictures on the mouse point
		Size = UDim2.fromOffset(64, 64),
		BackgroundTransparency = 1,
		Image = DEFAULT_CURSOR,
		Visible = false,
		ZIndex = 60, -- above everything
		Parent = gui,
	})
	local cursorPos = nil -- where the cursor copy is drawn (nil = not shown)
	local savedMouseIcon = nil -- MouseIconEnabled before we hid it

	local function hideSystemCursor(hidden)
		if hidden and savedMouseIcon == nil then
			savedMouseIcon = UserInputService.MouseIconEnabled
			UserInputService.MouseIconEnabled = false
		elseif not hidden and savedMouseIcon ~= nil then
			UserInputService.MouseIconEnabled = savedMouseIcon
			savedMouseIcon = nil
		end
	end

	local function releaseCursor()
		cursorPos = nil
		aimCursor.Visible = false
		hideSystemCursor(false)
	end

	-- slides the cursor copy onto the target, and back to the mouse when released
	local function updateCursor(dt, cam, mouse, aimPos)
		local goal = mouse
		if aimPos then
			local screen = cam:WorldToViewportPoint(aimPos)
			goal = Vector2.new(screen.X, screen.Y)
		elseif not cursorPos then
			return -- nothing locked and nothing to bring back
		end
		cursorPos = cursorPos or mouse
		local alpha = 1 - (state.aimSmooth / 100) ^ (dt * 60)
		cursorPos = cursorPos:Lerp(goal, alpha)
		if not aimPos and (cursorPos - mouse).Magnitude < 2 then
			releaseCursor() -- back on the mouse: show the normal cursor again
			return
		end
		-- the same picture as your cursor: the game's own cursor if it has one, otherwise the Roblox arrow
		local icon = mouseObject.Icon
		aimCursor.Image = (icon ~= nil and icon ~= "") and icon or DEFAULT_CURSOR
		aimCursor.Visible = true
		aimCursor.Position = UDim2.fromOffset(cursorPos.X, cursorPos.Y)
		hideSystemCursor(true)
	end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local MAX_PITCH = math.rad(80) -- Roblox doesn't let the camera look straighter up / down

	-- NPCs: humanoids in workspace that don't belong to players.
	-- Found once when Target NPCs is first turned on, then new ones are tracked.
	local npcHumanoids = setmetatable({}, { __mode = "k" }) -- removed ones are forgotten by themselves
	local npcWatching = false
	local function watchNpcs()
		npcWatching = true
		workspace.DescendantAdded:Connect(function(object)
			if object:IsA("Humanoid") then
				npcHumanoids[object] = true
			end
		end)
		task.spawn(function()
			for index, object in ipairs(workspace:GetDescendants()) do
				if object:IsA("Humanoid") then
					npcHumanoids[object] = true
				end
				if index % 2000 == 0 then
					task.wait() -- big maps: spread the scan over several frames
				end
			end
		end)
	end

	-- yaw / pitch of a direction (radians); the camera never rolls
	local function yawPitch(direction)
		return math.atan2(-direction.X, -direction.Z), math.asin(math.clamp(direction.Y, -1, 1))
	end

	local function wrapAngle(angle)
		return (angle + math.pi) % (2 * math.pi) - math.pi
	end

	local function rotation(yaw, pitch)
		return CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	end

	-- The head bobs and sways when the target walks (animation). Aim at the head height
	-- above the body instead, so the aim doesn't shake with the walking animation
	local headHeights = setmetatable({}, { __mode = "k" })
	local function stablePoint(character, part)
		local root = character:FindFirstChild("HumanoidRootPart")
		if part.Name ~= "Head" or not root or root == part then
			return part.Position
		end
		local height = part.Position.Y - root.Position.Y
		local smoothHeight = headHeights[character]
		smoothHeight = smoothHeight and (smoothHeight + (height - smoothHeight) * 0.1) or height
		headHeights[character] = smoothHeight
		return root.Position + Vector3.new(0, smoothHeight, 0)
	end

	local function aimPart(character)
		if state.aimHead then
			return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
		end
		return character:FindFirstChild("UpperTorso")
			or character:FindFirstChild("Torso")
			or character:FindFirstChild("HumanoidRootPart")
	end

	-- is there a clear line from your head to the target?
	-- Invisible barriers and parts without collision don't count as walls
	local function isVisible(origin, part, character)
		if not state.aimWallCheck then
			return true
		end
		local ignore = { workspace.CurrentCamera }
		if player.Character then
			table.insert(ignore, player.Character)
		end
		for _ = 1, 6 do
			rayParams.FilterDescendantsInstances = ignore
			local result = workspace:Raycast(origin, part.Position - origin, rayParams)
			if not result then
				return true
			end
			local hit = result.Instance
			if hit:IsDescendantOf(character) then
				return true
			end
			if hit.Transparency < 0.95 and hit.CanCollide then
				return false
			end
			table.insert(ignore, hit)
		end
		return false
	end

	-- returns the point to aim at and its distance from the aim pixel,
	-- or nil if this character can't be a target.
	-- keepLock = true for the target we are already locked on: then it doesn't have to be
	-- on screen or inside the circle, so a fast mouse flick can't break the lock
	local function checkTarget(character, cam, aimPixel, origin, myRoot, keepLock)
		if not character or character == player.Character or not character:IsDescendantOf(workspace) then
			return nil
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return nil
		end
		local owner = Players:GetPlayerFromCharacter(character)
		if owner == player or (not owner and not state.aimNpcs) then
			return nil
		end
		if owner and state.aimTeamCheck and owner.Team ~= nil and owner.Team == player.Team then
			return nil
		end
		local part = aimPart(character)
		if not part then
			return nil
		end
		if myRoot and (part.Position - myRoot.Position).Magnitude > state.aimMaxDistance then
			return nil
		end
		local gap = 0
		if not keepLock then
			-- picking a new target: it must be on screen, inside the circle (checked by the caller)
			local screen, onScreen = cam:WorldToViewportPoint(part.Position)
			if not onScreen then
				return nil
			end
			gap = (Vector2.new(screen.X, screen.Y) - aimPixel).Magnitude
		end
		if not isVisible(origin, part, character) then
			return nil
		end
		-- prediction: aim where the target will be after aimPrediction ms
		local point = stablePoint(character, part) + part.AssemblyLinearVelocity * (state.aimPrediction / 1000)
		return point, gap
	end

	-- where the camera turns around: your head in third person / Shift Lock,
	-- the camera itself in first person or in games with their own camera
	local function cameraPivot(cam, camCF)
		if cam.CameraType ~= Enum.CameraType.Scriptable then
			local focus = cam.Focus.Position
			local offset = camCF.Position - focus
			local zoom = offset.Magnitude
			-- trust Focus only when the camera really looks through it
			if zoom < 0.01 then
				return focus, 0
			end
			if zoom < 400 and offset.Unit:Dot(camCF.LookVector) < -0.98 then
				return focus, zoom
			end
		end
		return camCF.Position, 0
	end

	-- yaw / pitch that put aimPos exactly on the aim pixel. The camera position
	-- depends on where it looks (it orbits the pivot), so both are solved together
	local function solveAim(cam, camCF, pivot, zoom, aimPixel, aimPos)
		local pixelRay = cam:ViewportPointToRay(aimPixel.X, aimPixel.Y)
		local localDirection = camCF:VectorToObjectSpace(pixelRay.Direction)
		local yaw, pitch = yawPitch(camCF.LookVector)
		for _ = 1, 16 do
			local rot = rotation(yaw, pitch)
			local want = aimPos - (pivot - rot.LookVector * zoom)
			if want.Magnitude < 0.05 then
				break
			end
			local wantYaw, wantPitch = yawPitch(want.Unit)
			local gotYaw, gotPitch = yawPitch(rot:VectorToWorldSpace(localDirection))
			local stepYaw, stepPitch = wrapAngle(wantYaw - gotYaw), wantPitch - gotPitch
			yaw = yaw + stepYaw
			pitch = math.clamp(pitch + stepPitch, -MAX_PITCH, MAX_PITCH)
			if math.abs(stepYaw) < 1e-5 and math.abs(stepPitch) < 1e-5 then
				break -- exact enough
			end
		end
		return yaw, pitch
	end

	local function targetName(character)
		local owner = Players:GetPlayerFromCharacter(character)
		return owner and owner.DisplayName or character.Name
	end

	-- turns the camera so the given screen pixel points exactly at aimPos.
	-- alpha 1 = at once, smaller = part of the way (smoothness)
	local function aimCamera(cam, aimPixel, aimPos, alpha)
		local camCF = cam.CFrame
		local pivot, zoom = cameraPivot(cam, camCF)
		local goalYaw, goalPitch = solveAim(cam, camCF, pivot, zoom, aimPixel, aimPos)
		local yaw, pitch = yawPitch(camCF.LookVector)
		yaw = yaw + wrapAngle(goalYaw - yaw) * alpha
		pitch = pitch + (goalPitch - pitch) * alpha
		local rot = rotation(yaw, pitch)
		cam.CFrame = CFrame.new(pivot - rot.LookVector * zoom) * rot
	end

	-- Shooting in cursor mode. Guns shoot where the REAL mouse points (mouse.Hit), and
	-- scripts can't move the real mouse. So when you shoot, the camera turns at once so
	-- the real mouse points at the target — then the bullets hit.
	--   • the camera turns the moment you click
	--   • after the first shot the camera keeps the real mouse on the target until you
	--     stop aiming, so every next click is already aimed
	local shootHeld = false -- left mouse button held in the game (not on a menu)
	local fireLatch = false -- you shot while locked: keep the real mouse on the target
	local lockedPos = nil -- the point we are locked on in cursor mode
	local mouseObject2 = player:GetMouse()

	-- the pixel the game's gun shoots through: the mouse, or the screen center
	local function shotPixel(cam, mouse)
		if state.aimCursor then
			return mouse
		end
		local viewport = cam.ViewportSize
		return Vector2.new(viewport.X / 2, viewport.Y / 2)
	end

	local function overMenu(pos)
		if not menuVisible then
			return false
		end
		local p, size = holder.AbsolutePosition, holder.AbsoluteSize
		return pos.X >= p.X and pos.X <= p.X + size.X and pos.Y >= p.Y and pos.Y <= p.Y + size.Y
	end

	local function onShootPressed()
		local mouse = UserInputService:GetMouseLocation()
		if overMenu(mouse) then
			return
		end
		shootHeld = true
		local cam = workspace.CurrentCamera
		if lockedPos and cam and state.aimbotEnabled and state.aimShootSnap then
			fireLatch = true
			aimCamera(cam, shotPixel(cam, mouse), lockedPos, 1)
		end
	end

	-- clean up the click capture of version 2.9.1 if it is still bound
	-- (it could take clicks away from buttons and guns)
	pcall(function()
		game:GetService("ContextActionService"):UnbindAction("W1MIW_AimShoot")
	end)
	-- when you click in the game (not on buttons), aim the real mouse at the target
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and not gameProcessed then
			onShootPressed()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			shootHeld = false
		end
	end)

	-- red dot: where the game's mouse.Hit really points (what most guns shoot at)
	local shotMarker = create("Frame", {
		Name = "ShotPoint",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(9, 9),
		BackgroundColor3 = Color3.fromRGB(255, 50, 50),
		Visible = false,
		ZIndex = 61,
		Parent = gui,
	})
	round(shotMarker)
	stroke(shotMarker, 0, 1.5, COMMON.White)

	local function updateShotMarker(cam)
		if not state.aimShowShotPoint then
			shotMarker.Visible = false
			return
		end
		local ok, hit = pcall(function()
			return mouseObject2.Hit
		end)
		if not ok or not hit then
			shotMarker.Visible = false
			return
		end
		local screen, onScreen = cam:WorldToViewportPoint(hit.Position)
		shotMarker.Visible = onScreen
		shotMarker.Position = UDim2.fromOffset(screen.X, screen.Y)
	end

	-- Lock the camera on aimPos. The exact aim is solved again every frame, so walking,
	-- Shift Lock and the Roblox camera can't make it shake. Only YOUR mouse movement is
	-- smoothed: it can push the aim a little and the aim springs back (Smoothness)
	local lockYaw, lockPitch = nil, nil -- the angles we set last frame (nil = not locked)
	local lockTarget = nil
	local devYaw, devPitch = 0, 0 -- how far your mouse pushed the aim off the target
	local HAND_SHAKE = math.rad(0.8) -- mouse turns smaller than this per frame are ignored
	local function lockCamera(cam, aimPixel, aimPos, dt)
		local camCF = cam.CFrame
		local pivot, zoom = cameraPivot(cam, camCF)
		local goalYaw, goalPitch = solveAim(cam, camCF, pivot, zoom, aimPixel, aimPos)
		local curYaw, curPitch = yawPitch(camCF.LookVector)
		if lockYaw == nil or lockTarget ~= state.aimTarget then
			-- just locked on: start from where you look and pull in smoothly
			devYaw, devPitch = wrapAngle(curYaw - goalYaw), curPitch - goalPitch
		else
			-- what your mouse turned since the last frame. Tiny turns (a shaking hand)
			-- are ignored so the aim doesn't tremble; real mouse movement still counts
			local turnYaw, turnPitch = wrapAngle(curYaw - lockYaw), curPitch - lockPitch
			local turn = math.sqrt(turnYaw * turnYaw + turnPitch * turnPitch)
			if turn > HAND_SHAKE then
				local used = (turn - HAND_SHAKE) / turn
				devYaw = devYaw + turnYaw * used
				devPitch = devPitch + turnPitch * used
			end
		end
		-- 0 = glued to the target, higher = your mouse can move it more; same at any FPS
		local keep = (state.aimSmooth / 100) ^ (dt * 60)
		devYaw, devPitch = devYaw * keep, devPitch * keep
		local yaw = goalYaw + devYaw
		local pitch = math.clamp(goalPitch + devPitch, -MAX_PITCH, MAX_PITCH)
		local rot = rotation(yaw, pitch)
		cam.CFrame = CFrame.new(pivot - rot.LookVector * zoom) * rot
		lockYaw, lockPitch, lockTarget = yaw, pitch, state.aimTarget
	end

	local function updateAim(dt)
		local cam = workspace.CurrentCamera
		if not state.aimbotEnabled or not cam then
			fovCircle.Visible = false
			state.aimTarget = nil
			if cursorPos then
				releaseCursor()
			end
			lockedPos = nil
			fireLatch = false
			lockYaw = nil
			shotMarker.Visible = false
			_G.W1MIW_AimPosition = nil
			_G.W1MIW_AimTarget = nil
			return
		end
		if state.aimNpcs and not npcWatching then
			watchNpcs()
		end

		local viewport = cam.ViewportSize
		local mouse = UserInputService:GetMouseLocation()
		-- free cursor (Shift Lock off, not first person): move the cursor, not the camera
		local cursorMode = state.aimMoveCursor
			and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter
		local aimPixel = (cursorMode or state.aimCursor) and mouse
			or Vector2.new(viewport.X / 2, viewport.Y / 2)
		fovCircle.Visible = state.aimShowFov
		fovCircle.Position = UDim2.fromOffset(aimPixel.X, aimPixel.Y)
		fovCircle.Size = UDim2.fromOffset(state.aimFov * 2, state.aimFov * 2)

		local typing = UserInputService:GetFocusedTextBox() ~= nil
		-- the menu is open: pause, so you always see your real cursor and can click buttons
		local aiming = not typing and not menuVisible
			and (not state.aimHold or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2))
		local myCharacter = player.Character
		local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
		local myHead = myCharacter and myCharacter:FindFirstChild("Head")
		local camCF = cam.CFrame
		-- walls are checked from your head (where you shoot from)
		local origin = myHead and myHead.Position or camCF.Position

		local aimPos = nil
		if aiming then
			-- stay on the current target while it is still valid
			if state.aimTarget then
				aimPos = checkTarget(state.aimTarget, cam, aimPixel, origin, myRoot, true)
			end
			-- otherwise pick the one closest to the aim pixel inside the circle
			if not aimPos then
				state.aimTarget = nil
				local best = state.aimFov
				local function consider(character)
					local point, gap = checkTarget(character, cam, aimPixel, origin, myRoot)
					if point and gap <= best then
						best = gap
						aimPos = point
						state.aimTarget = character
					end
				end
				for _, other in ipairs(Players:GetPlayers()) do
					if other ~= player then
						consider(other.Character)
					end
				end
				if state.aimNpcs then
					for humanoid in pairs(npcHumanoids) do
						local model = humanoid.Parent
						if model and humanoid:IsDescendantOf(workspace) then
							if not Players:GetPlayerFromCharacter(model) then
								consider(model)
							end
						else
							npcHumanoids[humanoid] = nil -- removed from the game
						end
					end
				end
			end
		else
			state.aimTarget = nil
		end

		-- the circle lights up while locked
		fovStroke.Color = aimPos and THEME.Accent2 or THEME.Accent
		fovStroke.Thickness = aimPos and 2.5 or 1.5
		targetLabel.TextColor3 = THEME.Accent2
		targetLabel.Text = aimPos and ("Target: " .. targetName(state.aimTarget)) or ""

		-- for your own guns: where the aimbot is aiming right now (nil = not locked)
		_G.W1MIW_AimPosition = aimPos
		_G.W1MIW_AimTarget = aimPos and state.aimTarget or nil

		if menuVisible and cursorPos then
			releaseCursor() -- show the real cursor right away
		end
		if cursorMode then
			lockedPos = aimPos
			if not aimPos then
				fireLatch = false -- stopped aiming / lost the target
			end
			if aimPos and state.aimShootSnap and (shootHeld or fireLatch) then
				-- shooting: the real mouse must point at the target, so the camera turns
				aimCamera(cam, shotPixel(cam, mouse), aimPos, 1)
			end
			updateCursor(dt, cam, mouse, aimPos) -- not shooting: the camera is left alone
			updateShotMarker(cam)
			lockYaw = nil
			return
		end
		lockedPos = nil
		fireLatch = false
		updateCursor(dt, cam, mouse, nil) -- e.g. Shift Lock turned on: bring the cursor back

		if aimPos then
			lockCamera(cam, aimPixel, aimPos, dt)
		else
			lockYaw = nil
		end
		updateShotMarker(cam)
	end

	-- runs right after the default camera, so the aim is not overwritten
	pcall(function()
		RunService:UnbindFromRenderStep("W1MIW_Aimbot")
	end)
	RunService:BindToRenderStep("W1MIW_Aimbot", Enum.RenderPriority.Camera.Value + 1, updateAim)
	gui.Destroying:Connect(function()
		RunService:UnbindFromRenderStep("W1MIW_Aimbot")
		releaseCursor()
		_G.W1MIW_AimPosition = nil
		_G.W1MIW_AimTarget = nil
	end)
end

