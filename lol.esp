--[[
	W1MIW HUB — a stylish menu
	Language: Luau (Roblox)

	Script type: LocalScript
	Put it in: StarterPlayer → StarterPlayerScripts

	What's inside:
	  • intro screen: logo, your name and a loading bar
	  • blurred game behind the menu, soft shadow and an animated border
	  • Home, Features, Wallhack, Aimbot, Teleport, Mimic, MM2 Value,
	    Themes, Settings, Profile and Info tabs
	  • notifications in the bottom-right corner
	  • profile with your avatar, name and a Halloween countdown

	Features (Features tab):
	  • Fly with animation — F to turn on / off
	      WASD — fly, Space — up, Ctrl — down
	  • Infinite Jump — press Space in mid-air
	  • Speed — run faster (X to turn on / off), Walk Speed and Fly Speed sliders
	  • Anti-Fling — other players can't fling you

	Wallhack (Wallhack tab):
	  • Player ESP — see players through walls (V to turn on / off)
	  • Name Tags — name, distance and health above every player
	  • Noclip — walk through walls (N to turn on / off)
	  • Murder Mystery 2: Role ESP — murderer red, sheriff blue (innocents green if you want),
	    dropped gun yellow, Auto Grab Gun — picks up the sheriff's gun and teleports you back

	Aimbot (Aimbot tab):
	  • B — turn on / off, hold the right mouse button to aim
	  • the camera locks on to the player closest to your cursor inside the FOV circle
	    and puts them exactly under the cursor (first person, third person, Shift Lock)
	  • Shift Lock off (free cursor): the cursor jumps to the target, the camera stays still;
	    when you shoot, the camera turns at once so the bullets hit the target;
	    your own guns can also shoot at _G.W1MIW_AimPosition
	  • FOV radius, FOV circle, smoothness, aim at cursor / center, prediction,
	    head / body, wall check, team check, NPC targets, max distance

	Teleport (Teleport tab):
	  • list of everyone on the server with avatar, name and distance — press TP
	  • search by name, distance behind the player
	  • Click Teleport: hold Ctrl and left-click to teleport to that spot
	  • Places: small tiles (Prison Life spots from SimpleTP), + adds a tile for your spot, Back returns

	Mimic (Mimic tab):
	  • pick a player and press Copy: your character repeats every move they make
	  • beside them or from your own spot, mirror mode, copies animations and emotes
	  • M (or Stop) — stop copying

	MM2 Value (MM2 Value tab, Murder Mystery 2):
	  • type any item and see what it is worth (godlies, chromas, ancients, uniques, vintages, pets)
	  • while you trade: what you give, what you get and PROFIT / LOSS — in the tab and in a box
	    at the top of the screen; fix any value in the game ("Fix A Value")

	Settings (Settings tab) — everything can be changed while playing:
	  • Fly: speed, Superman pose, body tilt, hover bobbing, follow camera
	  • Infinite Jump: air jump power
	  • Speed: walk speed, hold Shift to sprint
	  • Anti-Fling: ghost players, return to safe spot, alerts
	  • Player ESP: fill, outline, max distance, distance / HP, team check, team colors
	  • Noclip: only while flying
	  • Menu: blur, blur strength, window transparency, animated border, notifications
	  • Keybinds: click a key button and press a new key

	Controls:
	  • G or the round W button on the left — hide / show the menu
	  • drag the window by its top bar
	  • "—" minimize, "□" maximize, "×" hide

	Themes (Themes tab):
	  • click a theme card — the whole menu is recolored smoothly
	  • Auto Theme — themes change by themselves every few seconds
	  • start theme is set in CONFIG.Theme:
	    Pumpkin, Witch, Vampire, Ghost, Potion, Midnight, Candy, Skeleton, Cursed
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- started twice in the same server within a few seconds (autoexec + the rejoin
-- queue both start it): the first one keeps running, this one stops here
do
	local shared = (type(getgenv) == "function" and getgenv()) or _G
	if shared.W1MIW_JobId == game.JobId and os.clock() - (shared.W1MIW_StartedAt or -1e9) < 10 then
		return
	end
	shared.W1MIW_JobId = game.JobId
	shared.W1MIW_StartedAt = os.clock()
end

while not workspace.CurrentCamera do
	task.wait()
end
local camera = workspace.CurrentCamera
local random = Random.new()

---------------------------------------------------------------------
-- SETTINGS
---------------------------------------------------------------------
local CONFIG = {
	Title = string.upper(player.Name) .. " HUB",
	Logo = "W",
	Author = "by " .. player.Name,
	Version = "Version 6.5",
	ToggleKey = Enum.KeyCode.G, -- hide / show the menu
	Theme = "Pumpkin", -- Pumpkin, Witch, Vampire, Ghost, Potion, Midnight, Candy, Skeleton, Cursed
	AutoThemeDelay = 6, -- seconds between themes when Auto Theme is on
	Width = 720,
	Height = 520,
	Transparency = 0.16, -- window transparency: 0 = solid, 1 = invisible
	ScreenMargin = 16, -- gap (pixels) between the screen edges and the menu / W button
	ShowIntro = true, -- intro screen on start
	Blur = true, -- blur the game behind the menu
	BlurSize = 10,
	AnimatedBorder = true, -- animated border
	InfiniteJump = false, -- Infinite Jump is on right from the start

	Fly = false, -- Fly is on right from the start
	FlyKey = Enum.KeyCode.F, -- take off / land
	FlySpeed = 60, -- flying speed
	-- ID of your flying animation (for example "rbxassetid://1234567890").
	-- EVERYONE sees the animation. Empty = Superman pose from the script (only you see it)
	FlyAnimationId = "",
	FlySpeedMax = 300, -- the Fly Speed slider goes up to this

	Speed = false, -- Speed is on right from the start
	SpeedKey = Enum.KeyCode.X, -- turn Speed on / off
	WalkSpeed = 50, -- running speed while Speed is on (normal Roblox speed is 16)
	WalkSpeedMax = 500, -- the Walk Speed slider goes up to this

	AntiFling = false, -- Anti-Fling is on right from the start

	-- Wallhack
	ESP = false, -- Player ESP is on right from the start
	ESPKey = Enum.KeyCode.V, -- turn Player ESP on / off
	ESPNames = true, -- name, distance and health above players
	ESPMaxDistance = 1000, -- name tags are hidden farther than this (studs)

	-- Murder Mystery 2 (Wallhack tab)
	RoleESP = false, -- murderer red, sheriff blue, through walls
	RoleESPInnocents = false, -- everyone else green
	GunDropESP = true, -- yellow outline on the gun the sheriff dropped
	AutoGrabGun = false, -- when the sheriff dies, grab his gun automatically
	GunGrabReturn = true, -- go back to where you were after grabbing it
	Noclip = false, -- Noclip is on right from the start
	NoclipKey = Enum.KeyCode.N, -- turn Noclip on / off

	-- Aimbot
	Aimbot = false, -- Aimbot is on right from the start
	AimbotKey = Enum.KeyCode.B, -- turn Aimbot on / off
	AimFOV = 150, -- radius of the FOV circle in pixels
	AimSmoothness = 25, -- 0 = rigid lock, 20–40 = your mouse can move the aim a little and it pulls back, 95 = very slow
	AimMaxDistance = 1000, -- players farther than this (studs) are ignored
	AimAtCursor = true, -- true = put the target under the cursor, false = in the screen center
	AimPrediction = 0, -- ms to aim ahead of moving targets (0 = off)
	AimNPCs = false, -- also aim at NPCs and dummies
	-- false (best for hitting): while you aim, the camera keeps the target exactly under
	-- your real mouse, so every shot — even the first — goes into the target.
	-- true: the cursor jumps to the target and the camera only turns when you shoot
	-- (looks nicer, but guns shoot where the real mouse is, so it is less accurate)
	AimMoveCursor = false,
	-- in cursor mode: when you shoot, the camera turns at once so your real mouse points
	-- at the target, otherwise the bullets would fly where the real mouse is
	AimShootSnap = true,

	-- Teleport
	TeleportOffset = 3, -- studs behind the player you teleport to
	ClickTeleport = false, -- Ctrl + click teleports you to the mouse
	TPButtons = false, -- a TP button above EVERY player's head (or press + next to one player)
	-- Places on the Teleport tab: { name, x, y, z }. Save new ones in the game with
	-- "+ Save current spot" and paste the line it shows here to keep them forever
	Places = {
