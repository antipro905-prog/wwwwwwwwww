local COMMON = {
	Text = Color3.fromRGB(246, 240, 234),
	SubText = Color3.fromRGB(188, 178, 170),
	TabText = Color3.fromRGB(222, 213, 205),
	White = Color3.new(1, 1, 1),
	Black = Color3.new(0, 0, 0),
	Green = Color3.fromRGB(70, 235, 120),
	Close = Color3.fromRGB(235, 70, 60),
}

-- current colors (theme + shared)
local THEME = {}
local currentTheme = THEMES[1]

local function loadTheme(name)
	for _, theme in ipairs(THEMES) do
		if theme.Name == name then
			currentTheme = theme
		end
	end
	for key, value in pairs(COMMON) do
		THEME[key] = value
	end
	for key, value in pairs(currentTheme) do
		THEME[key] = value
	end
end
loadTheme(CONFIG.Theme)

local FONT_BOLD = Enum.Font.GothamBold
local FONT_MEDIUM = Enum.Font.GothamMedium
local FONT_REGULAR = Enum.Font.Gotham

-- all feature switches and settings live in one table
-- (Luau allows at most 200 local variables per script)
local state = {}
state.onClose = {} -- run when the menu is destroyed (the script was started again)

---------------------------------------------------------------------
-- HELPERS
---------------------------------------------------------------------
-- Some games (Murder Mystery 2) put their own font on EVERY text on the screen —
-- in MM2's font "A" is a star, so the menu looked broken. Every text of the menu
-- keeps its own font: when the game changes it, it is changed back at once
local OWN_FONTS = {}
for _, enumFont in ipairs({ Enum.Font.GothamBold, Enum.Font.GothamMedium, Enum.Font.Gotham, Enum.Font.Code }) do
	pcall(function()
		OWN_FONTS[Font.fromEnum(enumFont).Family] = true
	end)
end
-- If the game keeps forcing its font again and again (a fight that would make the
-- game lag and your character stutter), the menu gives up on that text after 3 tries
local function keepFont(instance)
	pcall(function()
		local mine = instance.FontFace
		if not mine then
			return
		end
		local fixes, firstFix = 0, 0
		local function check()
			local face = instance.FontFace
			if OWN_FONTS[face.Family] then
				mine = face -- the menu itself changed it
			elseif face ~= mine and fixes < 3 then
				if fixes == 0 or os.clock() - firstFix > 10 then
					fixes, firstFix = 0, os.clock()
				end
				fixes = fixes + 1
				-- a moment later, not inside the game's own change (no back-and-forth loop)
				task.defer(function()
					if instance.FontFace ~= mine and not OWN_FONTS[instance.FontFace.Family] then
						instance.FontFace = mine
					end
				end)
			end
		end
		-- games change either FontFace or the older Font property
		instance:GetPropertyChangedSignal("FontFace"):Connect(check)
		instance:GetPropertyChangedSignal("Font"):Connect(check)
	end)
end

local function create(className, props)
	local instance = Instance.new(className)
	if instance:IsA("GuiObject") then
		instance.BorderSizePixel = 0
	end
	local parent = props.Parent
	props.Parent = nil
	for key, value in pairs(props) do
		instance[key] = value
	end
	if className == "TextLabel" or className == "TextButton" or className == "TextBox" then
		keepFont(instance)
	end
	instance.Parent = parent
	return instance
end

local function tween(object, duration, goal, style, direction)
	local info = TweenInfo.new(duration, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out)
	local animation = TweenService:Create(object, info, goal)
	animation:Play()
	return animation
end

local function corner(parent, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 8), Parent = parent })
end

local function round(parent)
	return create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = parent })
end

local function stroke(parent, transparency, thickness, color)
	return create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = color or COMMON.White,
		Transparency = transparency or 0.9,
		Thickness = thickness or 1,
		Parent = parent,
	})
end

local function padding(parent, top, right, bottom, left)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		PaddingLeft = UDim.new(0, left or 0),
		Parent = parent,
	})
end

local function label(props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or FONT_MEDIUM
	props.TextSize = props.TextSize or 15
	props.TextColor3 = props.TextColor3 or COMMON.Text
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return create("TextLabel", props)
end

-- transparent ends and a visible middle (for divider lines)
local function fadeEdges(middle)
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, middle),
		NumberSequenceKeypoint.new(1, 1),
	})
end

local function staticAccent(parent, rotation)
	return create("UIGradient", {
		Rotation = rotation or 0,
		Color = ColorSequence.new(THEME.Accent, THEME.Accent2),
		Parent = parent,
	})
end

local function removeFrom(list, item)
	for index, value in ipairs(list) do
		if value == item then
			table.remove(list, index)
			return
		end
	end
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

---------------------------------------------------------------------
-- THEMES: everything that is recolored when the theme changes
---------------------------------------------------------------------
local themeHooks = {}

local function onTheme(hook)
	table.insert(themeHooks, hook)
	hook(true)
end

-- switch the whole menu to another theme (smoothly)
local function setTheme(name)
	if currentTheme.Name == name then
		return false
	end
	loadTheme(name)
	if currentTheme.Name ~= name then
		return false -- no theme with this name
	end
	CONFIG.Theme = name
	for _, hook in ipairs(themeHooks) do
		hook(false)
	end
	return true
end

local function paint(object, property, key)
	onTheme(function(instant)
		if instant then
			object[property] = THEME[key]
		else
			tween(object, 0.45, { [property] = THEME[key] })
		end
	end)
	return object
end

local function paintGradient(gradient, keyA, keyB)
	onTheme(function()
		gradient.Color = ColorSequence.new(THEME[keyA], THEME[keyB])
	end)
	return gradient
end

local spinningGradients = {} -- animated borders
local shimmerGradients = {} -- shine that runs across text
local swingers = {} -- objects that gently swing

local function accent(parent, rotation, spinning)
	local gradient = paintGradient(create("UIGradient", { Rotation = rotation or 0, Parent = parent }), "Accent", "Accent2")
	if spinning then
		table.insert(spinningGradients, gradient)
	end
	return gradient
end

local function shimmerSequence()
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, COMMON.Text),
		ColorSequenceKeypoint.new(0.4, COMMON.Text),
		ColorSequenceKeypoint.new(0.5, THEME.Accent2),
		ColorSequenceKeypoint.new(0.6, COMMON.Text),
		ColorSequenceKeypoint.new(1, COMMON.Text),
	})
end

local function shimmer(textObject)
	local gradient = create("UIGradient", { Offset = Vector2.new(-1, 0), Parent = textObject })
	onTheme(function()
		gradient.Color = shimmerSequence()
	end)
	table.insert(shimmerGradients, gradient)
	return gradient
end

---------------------------------------------------------------------
-- SCREEN AND BLUR
---------------------------------------------------------------------
local GUI_NAME = "W1MIW_HUB"

-- where the menu lives: the executor's own hidden screen folder if it has one (the
-- game can't restyle it or cover it with its windows), otherwise PlayerGui
-- MM2 goes through everything in PlayerGui (it even forces its font on it), and a
-- menu there can break the game's own scripts (walking without animation). So the
-- menu goes to gethui() or CoreGui when the executor allows it
local guiParent = playerGui
pcall(function()
	if type(gethui) == "function" then
		local hidden = gethui()
		if typeof(hidden) == "Instance" then
			guiParent = hidden
		end
	end
end)
if guiParent == playerGui then
	pcall(function()
		local coreGui = game:GetService("CoreGui")
		local probe = Instance.new("Folder")
		probe.Name = "W1MIW_Probe"
		probe.Parent = coreGui -- errors when the executor can't use CoreGui
		probe:Destroy()
		guiParent = coreGui
	end)
end
state.guiPlace = guiParent == playerGui and "PlayerGui (the game can see the menu)" or "hidden from the game"
for _, place in ipairs({ playerGui, guiParent }) do
	local oldGui = place:FindFirstChild(GUI_NAME)
	if oldGui then
		oldGui:Destroy()
	end
end
local oldBlur = Lighting:FindFirstChild(GUI_NAME .. "_Blur")
if oldBlur then
	oldBlur:Destroy()
end

local gui = create("ScreenGui", {
	Name = GUI_NAME,
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 10000, -- above the game's own windows (they can't cover the W button)
	Parent = guiParent,
})
-- full screen without safe-area insets, so GUI positions match mouse / screen positions
pcall(function()
	gui.ScreenInsets = Enum.ScreenInsets.None
end)

local blur = create("BlurEffect", { Name = GUI_NAME .. "_Blur", Size = 0, Parent = Lighting })
gui.Destroying:Connect(function()
	blur:Destroy()
	-- the script was started again: this old copy switches all its features off,
	-- so two copies never farm / fly / noclip at the same time
	for key, value in pairs(state) do
		if value == true then
			state[key] = false
		end
	end
	-- and puts everything back: normal speed, collisions, your own animations...
	for _, cleanup in ipairs(state.onClose) do
		pcall(cleanup)
	end
end)

-- MM2 starts its own scripts in PlayerGui again every time you respawn. If your
-- executor can't hide the menu, the menu is in PlayerGui too, and MM2's scripts run
-- into it right then. So from the moment you die until 4 seconds after the new
-- character appears, everything of the menu that is in PlayerGui waits outside it
do
	local ReplicatedFirst = game:GetService("ReplicatedFirst")
	local oldHideaway = ReplicatedFirst:FindFirstChild("W1MIW_Hideaway")
	if oldHideaway then
		oldHideaway:Destroy() -- a menu from an earlier run that was still waiting there
	end
	local hideaway = Instance.new("Folder")
	hideaway.Name = "W1MIW_Hideaway"
	hideaway.Parent = ReplicatedFirst
	local hidden = {} -- [object] = where it was
	local hideId = 0

	local function showMenu(id, delay)
		task.wait(delay)
		if id ~= hideId then
			return -- died again meanwhile
		end
		for object, place in pairs(hidden) do
			if object.Parent == hideaway and place.Parent then
				object.Parent = place
			end
		end
		table.clear(hidden)
	end

	local function hideMenu()
		hideId = hideId + 1
		local list = {}
		if gui:IsDescendantOf(playerGui) then
			table.insert(list, gui)
		end
		for _, child in ipairs(playerGui:GetChildren()) do
			if child ~= gui and string.sub(child.Name, 1, 5) == "W1MIW" then
				table.insert(list, child)
			end
		end
		for _, object in ipairs(list) do
			if hidden[object] == nil then
				hidden[object] = object.Parent
			end
			object.Parent = hideaway
		end
		-- no new character for a long time: come back anyway
		task.spawn(showMenu, hideId, 20)
	end

	local function watch(character)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if humanoid then
			humanoid.Died:Connect(hideMenu)
		end
	end
	if player.Character then
		task.spawn(watch, player.Character)
	end
	player.CharacterRemoving:Connect(hideMenu)
	player.CharacterAdded:Connect(function(character)
		task.spawn(watch, character)
		hideMenu() -- in case it wasn't hidden yet
		showMenu(hideId, 4)
	end)
	gui.Destroying:Connect(function()
		hideaway:Destroy()
	end)
end

---------------------------------------------------------------------
-- NOTIFICATIONS (bottom right)
---------------------------------------------------------------------
local toastHolder = create("Frame", {
	Name = "Notifications",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -20, 1, -20),
	Size = UDim2.new(0, 310, 1, -40),
	BackgroundTransparency = 1,
	ZIndex = 30,
	Parent = gui,
})
create("UIListLayout", {
	VerticalAlignment = Enum.VerticalAlignment.Bottom,
	Padding = UDim.new(0, 10),
	SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = toastHolder,
})

local toastCount = 0
local openToasts = {} -- close functions of the notifications on screen (oldest first)
state.notificationsEnabled = true -- Settings → Menu → Notifications

local function notify(title, text, duration)
	if not state.notificationsEnabled then
		return
	end
	duration = duration or 4
	toastCount = toastCount + 1
	-- never more than 5 at once: the oldest goes away (farms can run for days)
	if #openToasts >= 5 then
		local oldest = table.remove(openToasts, 1)
		pcall(oldest)
	end

	local wrapper = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		LayoutOrder = toastCount,
		Parent = toastHolder,
	})
	local toast = create("TextButton", {
		Position = UDim2.fromOffset(340, 0),
		Size = UDim2.new(1, 0, 0, 72),
		BackgroundColor3 = THEME.Window,
		BackgroundTransparency = 0.06,
		AutoButtonColor = false,
		Text = "",
		Parent = wrapper,
	})
	corner(toast, 14)
	staticAccent(stroke(toast, 0.3, 1.5), 45)

	label({
		Position = UDim2.fromOffset(18, 14),
		Size = UDim2.new(1, -32, 0, 20),
		Text = title,
		Font = FONT_BOLD,
		TextSize = 15,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = toast,
	})
	label({
		Position = UDim2.fromOffset(18, 35),
		Size = UDim2.new(1, -32, 0, 18),
		Text = text,
		Font = FONT_REGULAR,
		TextSize = 13,
		TextColor3 = COMMON.SubText,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = toast,
	})
	local progress = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -8),
		Size = UDim2.new(1, -28, 0, 3),
		BackgroundColor3 = COMMON.White,
		Parent = toast,
	})
	round(progress)
	staticAccent(progress, 0)

	tween(wrapper, 0.35, { Size = UDim2.new(1, 0, 0, 72) })
	tween(toast, 0.6, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
	tween(progress, duration, { Size = UDim2.new(0, 0, 0, 3) }, Enum.EasingStyle.Linear)

	local closed = false
	local close
	function close()
		if closed then
			return
		end
		closed = true
		local index = table.find(openToasts, close)
		if index then
			table.remove(openToasts, index)
		end
		local slide = tween(toast, 0.4, { Position = UDim2.fromOffset(340, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		slide.Completed:Connect(function()
			local shrink = tween(wrapper, 0.25, { Size = UDim2.new(1, 0, 0, 0) })
			shrink.Completed:Connect(function()
				wrapper:Destroy()
			end)
		end)
	end
	toast.MouseButton1Click:Connect(close)
	table.insert(openToasts, close)
	task.delay(duration, close)
end

-- pop-ups from things that happen by themselves (farms, auto accept): silent in
-- Quiet Mode (Long Farm tab) so days of farming don't fill the screen
state.quietFarm = false
local function farmNotify(title, text, duration)
	if not state.quietFarm then
		notify(title, text, duration)
	end
end

