-- Walking without animation (the character's Animate script got switched off, or the
-- character stays "frozen" in PlatformStand) is repaired by this button (only when you press it)
do
	local animateOffFor, frozenFor = 0, 0

	-- full = also restart the Animate script (fixes animations that got stuck)
	local function fixCharacter(full)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return false
		end
		local fixed = false
		local animate = character:FindFirstChild("Animate")
		if animate and animate:IsA("BaseScript") then
			if animate.Disabled then
				animate.Disabled = false
				fixed = true
			elseif full then
				animate.Disabled = true
				task.wait()
				animate.Disabled = false
				fixed = true
			end
		end
		if humanoid.PlatformStand and not humanoid.SeatPart and (full or frozenFor >= 3) then
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			fixed = true
		end
		return fixed
	end

	local fixCard = card(functionsPage, 52, "TextButton")
	label({
		Position = UDim2.fromOffset(18, 8),
		Size = UDim2.new(1, -36, 0, 20),
		Text = "Fix My Character",
		Font = FONT_BOLD,
		TextSize = 16,
		Parent = fixCard,
	})
	label({
		Position = UDim2.fromOffset(18, 28),
		Size = UDim2.new(1, -36, 0, 16),
		Text = "Walking without animation or stuck? Press this",
		Font = FONT_REGULAR,
		TextSize = 13,
		TextColor3 = COMMON.SubText,
		Parent = fixCard,
	})
	fixCard.MouseButton1Click:Connect(function()
		if state.flyEnabled then
			flyToggle.Set(false)
		end
		if state.mimicOn and state.stopMimic then
			state.stopMimic()
		end
		if not state.speedEnabled then
			restoreSpeed()
		end
		if not state.noclipEnabled then
			restoreNoclip()
		end
		if not state.antiFlingEnabled then
			restoreCollisions()
		end
		task.wait(0.1)
		pcall(fixCharacter, true)
		notify("Character fixed", "Animations and movement are back to normal", 3)
	end)

	-- Character Check: everything that matters for walking, live (send a screenshot of it)
	local _, checkText = paragraph(functionsPage, "Character Check", "")
	task.spawn(function()
		while gui.Parent do
			if menuVisible then
				pcall(function()
					local character = player.Character
					local humanoid = character and character:FindFirstChildOfClass("Humanoid")
					local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
					local animate = character and character:FindFirstChild("Animate")
					local tracks = 0
					if animator then
						tracks = #animator:GetPlayingAnimationTracks()
					end
					local leftovers = 0
					if character then
						for _, object in ipairs(character:GetDescendants()) do
							if string.sub(object.Name, 1, 5) == "W1MIW" or object:IsA("LinearVelocity") or object:IsA("AlignOrientation") then
								leftovers = leftovers + 1
							end
						end
					end
					local on = {}
					for _, item in ipairs({ { "flyEnabled", "Fly" }, { "noclipEnabled", "Noclip" }, { "speedEnabled", "Speed" },
						{ "antiFlingEnabled", "Anti-Fling" }, { "mimicOn", "Mimic" }, { "infiniteJumpEnabled", "Inf Jump" }, { "aimbotEnabled", "Aimbot" } }) do
						if state[item[1]] then
							table.insert(on, item[2])
						end
					end
					checkText.Text = "Animate script: " .. (animate and (animate.Disabled and "OFF" or "on") or "missing")
						.. "   •   Animator: " .. (animator and "yes" or "NO")
						.. "   •   animations playing: " .. tracks
						.. "\nState: " .. (humanoid and humanoid:GetState().Name or "no character")
						.. "   •   PlatformStand: " .. (humanoid and tostring(humanoid.PlatformStand) or "-")
						.. "   •   WalkSpeed: " .. (humanoid and humanoid.WalkSpeed or "-")
						.. "\nLeft-over movers in the character: " .. leftovers
						.. "\nMenu features on: " .. (#on > 0 and table.concat(on, ", ") or "none")
						.. "\nMenu is " .. tostring(state.guiPlace)
				end)
			end
			task.wait(1)
		end
	end)

	-- (there is no automatic fixing every second any more: it touched the Animate script
	-- and PlatformStand while MM2 was still setting up your new character after a respawn)
end

