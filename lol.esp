	BackgroundColor3 = COMMON.White,
	BackgroundTransparency = 0.94,
	ZIndex = 1,
	Parent = main,
})
create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0, 1), Parent = shine })

